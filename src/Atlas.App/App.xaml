<Application x:Class="Atlas.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Atlas.App.Infrastructure"
             Startup="App_OnStartup" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AtlasTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <infra:PageVisibilityConverter x:Key="PageVisibility" />
            <infra:BoolVisibilityConverter x:Key="BoolVisibility" />
            <infra:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility" />
            <infra:InverseBoolConverter x:Key="InverseBool" />
            <infra:StatusLabelConverter x:Key="StatusLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
