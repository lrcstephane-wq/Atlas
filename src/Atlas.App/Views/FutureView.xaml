<UserControl x:Class="Atlas.App.Views.FutureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="38"><StackPanel><Border Width="68" Height="68" CornerRadius="34" Background="#E4EDFB"><TextBlock Text="◇" Foreground="{StaticResource BlueBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Module prévu" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Sa place est réservée dans l’architecture et la navigation. Nous le développerons lorsque ses règles métier seront suffisamment concrètes." Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center"/><Button Content="Revenir à Forge" Command="{Binding NavigateCommand}" CommandParameter="Components" HorizontalAlignment="Center" Margin="0,24,0,0"/></StackPanel></Border></Grid>
</UserControl>
