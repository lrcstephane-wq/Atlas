<UserControl x:Class="Atlas.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MaxWidth="1560" HorizontalAlignment="Center">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border Background="{StaticResource HeroGradient}" BorderBrush="#35617E" BorderThickness="1" CornerRadius="16" Padding="30,25" MinHeight="178" Effect="{StaticResource SoftShadow}">
    <Grid ClipToBounds="True"><Rectangle Fill="{StaticResource AtlasGridBrush}" Opacity=".5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="BIBLIDÉO ATLAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="De la Forge à l’expérience client" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Structurez vos composants, composez vos meubles et déployez-les dans TopSolid depuis un espace unique." Foreground="#BED0DF" FontSize="14" MaxWidth="720" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Ouvrir Forge — Composants" Command="{Binding NavigateCommand}" CommandParameter="Components"/><Button Content="Explorer Horizon" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="Catalog" Margin="9,0,0,0"/></StackPanel>
     </StackPanel>
     <Grid Grid.Column="1"><Ellipse Width="180" Height="180" Fill="#241BC5F2" HorizontalAlignment="Right"/><Ellipse Width="125" Height="125" Fill="#32117DB3" HorizontalAlignment="Right" Margin="0,0,27,0"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="88" Opacity=".7" HorizontalAlignment="Right" Margin="0,0,46,0"/></Grid>
    </Grid></Grid>
   </Border>

   <UniformGrid Grid.Row="2" Columns="4">
    <Border Style="{StaticResource RaisedCard}" Margin="0,0,12,0" Padding="18"><Grid><StackPanel><TextBlock Text="COMPOSANTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ComponentCount}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="fiches réelles indexées" Style="{StaticResource Caption}"/></StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#173E57" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="▦" Foreground="{StaticResource CyanBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
    <Border Style="{StaticResource RaisedCard}" Margin="0,0,12,0" Padding="18"><Grid><StackPanel><TextBlock Text="MEUBLES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding FurnitureCount}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="fiches en production" Style="{StaticResource Caption}"/></StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#3A3020" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="▤" Foreground="{StaticResource AmberBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
    <Border Style="{StaticResource RaisedCard}" Margin="0,0,12,0" Padding="18"><Grid><StackPanel><TextBlock Text="PUBLIÉS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PublishedCount}" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/><TextBlock Text="visibles côté client" Style="{StaticResource Caption}"/></StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#153D37" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
    <Border Style="{StaticResource RaisedCard}" Padding="18"><Grid><StackPanel><TextBlock Text="À CONTRÔLER" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding HealthIssueCount}" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" Margin="0,8,0,0"/><TextBlock Text="anomalies détectées" Style="{StaticResource Caption}"/></StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#3A3020" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="!" Foreground="{StaticResource AmberBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
   </UniformGrid>

   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="24"><StackPanel><TextBlock Text="LE PARCOURS ATLAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Un catalogue fiable, du composant au client" Style="{StaticResource SectionTitle}" Margin="0,5,0,20"/>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PrimaryGradient}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Indexer la bibliothèque" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Atlas lit uniquement les chemins et les noms des .TOP, jamais leur contenu." Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Grid>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PrimaryGradient}"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Enrichir et valider" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Chaque fiche conserve les données utiles et la provenance des informations." Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PrimaryGradient}"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Composer puis publier" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Horizon expose uniquement les meubles contrôlés et prêts à être déployés." Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Grid>
    </StackPanel></Border>
    <Border Grid.Column="2" Background="{StaticResource SurfaceGradient}" BorderBrush="#315772" BorderThickness="1" CornerRadius="14" Padding="24"><Grid><Rectangle Fill="{StaticResource AtlasGridBrush}" Opacity=".35"/><StackPanel><TextBlock Text="DÉMARRAGE RAPIDE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Votre espace de travail" Style="{StaticResource SectionTitle}" Margin="0,5,0,10"/><TextBlock Text="Configurez SC ou EP, choisissez la bibliothèque puis lancez l’indexation." Style="{StaticResource Caption}" FontSize="12"/>
     <Border Background="#0D2637" BorderBrush="#294C65" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="1. Paramètres" FontWeight="SemiBold"/><TextBlock Text="Définir les chemins partagés" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Background="#0D2637" BorderBrush="#294C65" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,9,0,0"><StackPanel><TextBlock Text="2. Forge" FontWeight="SemiBold"/><TextBlock Text="Indexer et contrôler les composants" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Border>
    </StackPanel></Grid></Border>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
