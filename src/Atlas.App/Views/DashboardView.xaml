<UserControl x:Class="Atlas.App.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Vue d’ensemble" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Le point d’entrée de Forge et du futur Catalogue Atlas." Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,22" />
            <UniformGrid Columns="4" Margin="0,0,0,22">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="COMPOSANTS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ComponentCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="fiches réelles indexées" Style="{StaticResource Caption}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEUBLES" Style="{StaticResource Caption}"/><TextBlock Text="{Binding FurnitureCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="fiches en production" Style="{StaticResource Caption}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PUBLIÉS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PublishedCount}" FontSize="32" FontWeight="SemiBold" Foreground="#238662" Margin="0,8,0,0"/><TextBlock Text="visibles côté client" Style="{StaticResource Caption}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="À CONTRÔLER" Style="{StaticResource Caption}"/><TextBlock Text="{Binding HealthIssueCount}" FontSize="32" FontWeight="SemiBold" Foreground="#C07A17" Margin="0,8,0,0"/><TextBlock Text="anomalies détectées" Style="{StaticResource Caption}"/></StackPanel></Border>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Le parcours V0.1" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlueBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Indexer la bibliothèque" FontWeight="SemiBold"/><TextBlock Text="Atlas lit uniquement les chemins et noms des .TOP, jamais leur contenu." Style="{StaticResource Caption}"/></StackPanel></Grid>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlueBrush}"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Enrichir et valider" FontWeight="SemiBold"/><TextBlock Text="Les fiches conservent les données utiles et la provenance de chaque information." Style="{StaticResource Caption}"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BlueBrush}"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Composer puis publier" FontWeight="SemiBold"/><TextBlock Text="Le meuble reprend les capacités et compatibilités de ses composants déclarés." Style="{StaticResource Caption}"/></StackPanel></Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Démarrage rapide" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Configurez SC ou EP, choisissez la bibliothèque puis lancez l’indexation." Style="{StaticResource Caption}" Margin="0,8,0,20" />
                        <Button Content="Ouvrir Forge — Composants" Command="{Binding NavigateCommand}" CommandParameter="Components" Margin="0,0,0,9" />
                        <Button Content="Voir l’aperçu client" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Catalog" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
