<Window x:Class="Atlas.App.Views.CustomerFurnitureCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="Catalogue personnel — Atlas" MinWidth="900" MinHeight="560" Width="1180" Height="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_OnPreviewKeyDown" Closing="Window_OnClosing">
 <Window.Resources>
  <Style x:Key="PersonalCatalogViewMode" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Shell" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="11,6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Border Background="#24282B" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <Grid Margin="18,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="4" Background="#30383D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><TextBlock Text="▤" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="CATALOGUE PERSONNEL" Style="{StaticResource Eyebrow}"/><TextBlock Text="Les meubles du client, séparés du catalogue Atlas" Style="{StaticResource Caption}"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/><Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click"/><Button Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_Click"/></StackPanel></Grid>
   </Border>
   <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="38,9,12,9" ToolTip="Nom, description, fichier ou emplacement"/><TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><ComboBox Grid.Column="2" ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}"/><ComboBox Grid.Column="4" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/><Button Grid.Column="5" Content="Effacer" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ClearFilters_OnClick"/></Grid>
   </Border>
   <Grid Grid.Row="2" Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="520"/><ColumnDefinition Width="12"/><ColumnDefinition Width="320" MinWidth="280" MaxWidth="370"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="14,0"><Grid><TextBlock Text="{Binding ResultLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><RadioButton Content="Liste" GroupName="PersonalView" Style="{StaticResource PersonalCatalogViewMode}" IsChecked="{Binding IsCardView, Converter={StaticResource InverseBool}}" Click="ViewMode_OnClick"/><RadioButton Content="Cartes" GroupName="PersonalView" Style="{StaticResource PersonalCatalogViewMode}" IsChecked="{Binding IsCardView}" Margin="-1,0,0,0" Click="ViewMode_OnClick"/></StackPanel></Grid></Border>
     <DataGrid x:Name="FurnitureGrid" Grid.Row="1" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" Visibility="{Binding IsCardView, Converter={StaticResource InverseBoolVisibility}}" MouseDoubleClick="FurnitureItems_OnMouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Nom du meuble" Binding="{Binding DisplayName}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Fichier" Binding="{Binding RelativeTopPath}" Width="1.3*" MinWidth="220"/><DataGridTextColumn Header="Détecté" Binding="{Binding LastSeenUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="95"/></DataGrid.Columns></DataGrid>
     <ListBox x:Name="FurnitureCards" Grid.Row="1" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}" Visibility="{Binding IsCardView, Converter={StaticResource BoolVisibility}}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Padding="12" MouseDoubleClick="FurnitureItems_OnMouseDoubleClick"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="225" ItemHeight="260" Spacing="12"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Padding="10" CornerRadius="6" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{StaticResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PreviewBrush}" CornerRadius="5"><Grid><TextBlock Text="Aperçu indisponible" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Stretch="Uniform" Margin="5" Loaded="CardImage_OnLoaded" Unloaded="CardImage_OnUnloaded"/></Grid></Border><StackPanel Grid.Row="1" Margin="1,9,1,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="38"/><TextBlock Text="{Binding RelativeTopPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,14"><StackPanel><TextBlock Text="APERÇU" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedFurniture.DisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedLocationLabel}" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0"/></StackPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="14"><Border Height="220" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7"><Grid><TextBlock Text="Aucun aperçu disponible" Foreground="#6A7479" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Preview}" Stretch="Uniform" Margin="8"/></Grid></Border><TextBlock Text="DESCRIPTION" Style="{StaticResource Eyebrow}" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedFurniture.Description}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="FICHIER SOURCE" Style="{StaticResource Eyebrow}" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedSourcePath}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></ScrollViewer><Border Grid.Row="2" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="14"><Button Content="Ouvrir dans Mes meubles" IsEnabled="{Binding HasSelection}" Click="OpenSelected_OnClick" HorizontalAlignment="Stretch"/></Border></Grid></Border>
   </Grid>
   <Border Grid.Row="3" Background="#24282B" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><TextBlock Text="{Binding AccessLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="Ctrl+K : rechercher · Échap : fermer" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Border>
</Window>
