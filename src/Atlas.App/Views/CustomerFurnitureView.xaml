<UserControl x:Class="Atlas.App.Views.CustomerFurnitureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Border Background="{StaticResource SurfaceGradient}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="20,16" Margin="0,0,0,14">
   <Grid>
    <StackPanel>
     <TextBlock Text="HORIZON / CATALOGUE PERSONNEL" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Mes meubles" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/>
     <TextBlock Text="Les fichiers Client restent séparés du catalogue officiel Atlas." Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="▤  Ouvrir le catalogue personnel" Style="{StaticResource SecondaryButton}" Click="OpenPersonalCatalog_OnClick"/>
     <Button Content="Analyser les emplacements" Command="{Binding SynchronizeCustomerFurnitureCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}"/>
     <Button Content="Enregistrer" Command="{Binding SaveCustomerFurnitureCommand}" Margin="8,0,0,0" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Border Grid.Row="1" Background="#344047" BorderBrush="#4D6570" BorderThickness="1" Padding="13,9" Margin="0,0,0,12" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource InverseBoolVisibility}}">
   <TextBlock Text="Consultation du catalogue personnel. Seul un compte Créateur disposant du module correspondant peut ajouter ou modifier ces meubles." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
  </Border>

  <TabControl Grid.Row="2">
   <TabItem Header="Meubles">
    <Grid Margin="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" MinWidth="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="12">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid><TextBlock Text="MEUBLES DÉTECTÉS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CustomerFurnitureCount, StringFormat='{}{0} meuble(s)'}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
       <ListBox Grid.Row="1" ItemsSource="{Binding CustomerFurniture}" SelectedItem="{Binding SelectedCustomerFurniture}" Margin="0,12,0,0">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelativeTopPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <Grid><TextBlock Text="FICHE CLIENT" Style="{StaticResource Eyebrow}"/><Button Content="Retirer d’Atlas" Command="{Binding ExcludeCustomerFurnitureCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}"/></Grid>
       <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
       <TextBox Text="{Binding SelectedCustomerFurniture.DisplayName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanManageCustomerFurniture, Converter={StaticResource InverseBool}}"/>
       <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
       <TextBox Text="{Binding SelectedCustomerFurniture.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" IsReadOnly="{Binding CanManageCustomerFurniture, Converter={StaticResource InverseBool}}"/>
       <TextBlock Text="Fichier source" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
       <TextBox Text="{Binding SelectedCustomerFurniture.RelativeTopPath}" IsReadOnly="True"/>
       <TextBlock Text="{Binding SelectedCustomerFurnitureFileStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Aperçu" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedCustomerFurniture.ImageRelativePath}" IsReadOnly="True"/></StackPanel>
        <Button Grid.Column="1" Content="Actualiser l’image" Command="{Binding ChooseCustomerFurnitureImageCommand}" Style="{StaticResource SecondaryButton}" Margin="8,20,0,0" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}"/>
       </Grid>
       <TextBlock Text="UNIVERS ATLAS" Style="{StaticResource Eyebrow}" Margin="0,20,0,8"/>
       <ItemsControl ItemsSource="{Binding SelectedCustomerAtlasUniverseOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.CanManageCustomerFurniture, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,16,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="UNIVERS CLIENT" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/>
       <ItemsControl ItemsSource="{Binding SelectedCustomerClientUniverseOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.CanManageCustomerFurniture, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,16,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="TAGS ATLAS" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/>
       <ItemsControl ItemsSource="{Binding SelectedCustomerAtlasTagOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.CanManageCustomerFurniture, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,16,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="TAGS CLIENT" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/>
       <ItemsControl ItemsSource="{Binding SelectedCustomerPersonalTagOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.CanManageCustomerFurniture, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,16,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="Emplacements Client" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="EMPLACEMENTS CLIENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Chaque emplacement est analysé avec tous ses sous-dossiers." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Content="Ajouter un emplacement" Command="{Binding ChooseCustomerFurnitureRootCommand}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding CustomerFurnitureLocations}" SelectedItem="{Binding SelectedCustomerFurnitureLocation}" Margin="0,14,0,0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding RootPath}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="Retirer" Style="{StaticResource GhostButton}" Command="{Binding DataContext.DeleteCustomerFurnitureLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </TabItem>
   <TabItem Header="Univers Client" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBox Text="{Binding NewClientUniverseName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom du nouvel Univers Client" Margin="0,0,100,0"/><Button Content="Ajouter" Command="{Binding AddClientUniverseCommand}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding ClientUniverses}" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><TextBlock Text="{Binding Label}"/><Button Content="Supprimer" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding DataContext.DeleteClientUniverseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </TabItem>
   <TabItem Header="Tags Client" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBox Text="{Binding NewPersonalTagName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom du nouveau Tag Client" Margin="0,0,100,0"/><Button Content="Ajouter" Command="{Binding AddPersonalTagCommand}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding PersonalTags}" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><TextBlock Text="{Binding Label}"/><Button Content="Supprimer" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding DataContext.DeletePersonalTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </TabItem>
   <TabItem Header="Meubles retirés" Visibility="{Binding CanManageCustomerFurniture, Converter={StaticResource BoolVisibility}}">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="MEUBLES RETIRÉS D’ATLAS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Les fichiers réseau sont conservés et ignorés lors des analyses." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ExcludedCustomerFurniture}" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelativeTopPath}" Style="{StaticResource Caption}"/></StackPanel><Button Content="Restaurer dans Atlas" HorizontalAlignment="Right" Command="{Binding DataContext.RestoreCustomerFurnitureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
