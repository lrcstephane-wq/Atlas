<UserControl x:Class="Atlas.App.Views.CustomerFurnitureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource SurfaceGradient}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
   <Grid><StackPanel><TextBlock Text="HORIZON / COLLECTION CLIENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Mes meubles" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/><TextBlock Text="Les fichiers restent séparés du catalogue officiel Atlas." Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0"/></StackPanel><Button Content="Enregistrer" Command="{Binding SaveCustomerFurnitureCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Dossier surveillé" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CustomerFurnitureRoot, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/><TextBlock Text="{Binding CustomerFurnitureRootStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="1" Content="Choisir" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseCustomerFurnitureRootCommand}" Margin="10,20,0,0"/>
    <Button Grid.Column="2" Content="Actualiser" Command="{Binding SynchronizeCustomerFurnitureCommand}" Margin="8,20,0,0"/>
    <Button Grid.Column="3" Content="Ouvrir le dossier" Style="{StaticResource GhostButton}" Command="{Binding OpenCustomerFurnitureFolderCommand}" Margin="8,20,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="MEUBLES DÉTECTÉS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CustomerFurnitureCount, StringFormat='{}{0} meuble(s)'}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
     <ListBox Grid.Row="1" ItemsSource="{Binding CustomerFurniture}" SelectedItem="{Binding SelectedCustomerFurniture}" Margin="0,12,0,0">
      <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelativeTopPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="FICHE CLIENT" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/><TextBox Text="{Binding SelectedCustomerFurniture.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/><TextBox Text="{Binding SelectedCustomerFurniture.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82"/>
     <TextBlock Text="Fichier source" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/><TextBox Text="{Binding SelectedCustomerFurniture.RelativeTopPath}" IsReadOnly="True"/><TextBlock Text="{Binding SelectedCustomerFurnitureFileStatus}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
     <TextBlock Text="Aperçu" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCustomerFurniture.ImageRelativePath}" IsReadOnly="True"/><Button Grid.Column="1" Content="Choisir une image" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseCustomerFurnitureImageCommand}" Margin="8,0,0,0"/></Grid>
     <TextBlock Text="REPÈRES PERSONNELS" Style="{StaticResource Eyebrow}" Margin="0,22,0,8"/>
     <ItemsControl ItemsSource="{Binding SelectedCustomerPersonalTagOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,9"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border Background="#102536" BorderBrush="#294B63" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="Créer un repère" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewPersonalTagName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. Modèle Michel"/><Button Grid.Column="1" Content="Ajouter" Command="{Binding AddPersonalTagCommand}" Margin="8,0,0,0"/></Grid><ItemsControl ItemsSource="{Binding PersonalTags}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><TextBlock Text="{Binding Label}"/><Button Content="Supprimer" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding DataContext.DeletePersonalTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,3"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
