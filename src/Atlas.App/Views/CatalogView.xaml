<UserControl x:Class="Atlas.App.Views.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Atlas.App.Controls">
 <UserControl.Resources>
  <Style x:Key="FavoriteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="ToolTip" Value="Épingler dans mes raccourcis"/>
  </Style>
  <Style x:Key="FacetToggle" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Shell" Background="#102434" BorderBrush="#29485F" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#173247" CornerRadius="10" Padding="7,2" Margin="8,0,34,0"><TextBlock Text="{Binding CountLabel}" FontSize="9" Foreground="{StaticResource MutedBrush}"/></Border></Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="#48708A"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource SelectionGradient}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UniverseToggle" TargetType="CheckBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Shell" Background="{StaticResource SurfaceGradient}" BorderBrush="#31516A" BorderThickness="1" CornerRadius="11" Padding="13,12" Margin="0,0,0,8" MinHeight="64">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><Border x:Name="Rail" Background="#365D76" CornerRadius="3" Margin="0,2,0,2"/><StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Count, StringFormat='{}{0} meuble(s)'}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="2" x:Name="State" Background="#152E41" CornerRadius="11" Padding="8,4" Margin="0,0,33,0" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StateText" Text="Choisir" FontSize="9" Foreground="{StaticResource MutedBrush}"/></Border></Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#4C7794"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource SelectionGradient}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Rail" Property="Background" Value="{StaticResource CyanBrush}"/><Setter TargetName="StateText" Property="Text" Value="Actif"/><Setter TargetName="StateText" Property="Foreground" Value="{StaticResource CyanBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="FacetTemplate"><Grid><CheckBox Style="{StaticResource FacetToggle}" IsChecked="{Binding IsSelected}"/><Button Content="{Binding FavoriteGlyph}" Style="{StaticResource FavoriteButton}" Click="ClientFacetFavorite_OnClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0"/></Grid></DataTemplate>
  <DataTemplate x:Key="UniverseTemplate"><Grid><CheckBox Style="{StaticResource UniverseToggle}" IsChecked="{Binding IsSelected}"/><Button Content="{Binding FavoriteGlyph}" Style="{StaticResource FavoriteButton}" Click="ClientFacetFavorite_OnClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,4,0"/></Grid></DataTemplate>
  <Style x:Key="FurnitureCard" TargetType="ToggleButton">
   <Setter Property="Background" Value="{StaticResource SurfaceGradient}"/><Setter Property="BorderBrush" Value="#2B4B62"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"><Grid><ContentPresenter/><Border x:Name="Choice" Width="30" Height="30" CornerRadius="8" Background="#D9071520" BorderBrush="#496A82" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"><TextBlock x:Name="Tick" Text="✓" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="#4B7896"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionGradient}"/><Setter TargetName="Choice" Property="Background" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>

 <Grid MaxWidth="1820" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <!-- Hero / recherche -->
  <Border Background="{StaticResource HeroGradient}" BorderBrush="#35617E" BorderThickness="1" CornerRadius="16" Padding="28,22" MinHeight="150" Effect="{StaticResource SoftShadow}">
   <Grid ClipToBounds="True"><Rectangle Fill="{StaticResource AtlasGridBrush}" Opacity=".55"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="ATLAS / HORIZON" Style="{StaticResource Eyebrow}"/><TextBlock Text="Explorez la collection" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Décrivez le meuble dont vous avez besoin. Horizon comprend aussi les approximations." Foreground="#BED0DF" FontSize="13" Margin="0,0,0,14"/>
     <Border Background="#E6091824" BorderBrush="#4B7997" BorderThickness="1" CornerRadius="13" Height="52" MaxWidth="980" HorizontalAlignment="Stretch"><Grid><TextBlock Text="⌕" FontSize="25" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="17,0,0,3"/><TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="16" Padding="54,0,16,0" ToolTip="Rechercher librement : meuble évier, four micro-ondes, rangement coulissant…"/></Grid></Border>
     <TextBlock Text="{Binding ClientSearchInterpretation}" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="8,7,0,0" Visibility="{Binding HasClientSearchInterpretation, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
    <Grid Grid.Column="1"><Ellipse Width="150" Height="150" Fill="#271BC5F2" HorizontalAlignment="Right"/><Ellipse Width="104" Height="104" Fill="#34107BAE" HorizontalAlignment="Right" Margin="0,0,23,0"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="74" Opacity=".62" HorizontalAlignment="Right" Margin="0,0,38,0"/><Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="13,7"><TextBlock Text="{Binding PublishedCount, StringFormat='{}{0} meuble(s) disponible(s)'}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/></Border></Grid>
   </Grid></Grid>
  </Border>

  <!-- Navigation à facettes / résultats / sélection -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="235" MaxWidth="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350" MinWidth="310" MaxWidth="410"/></Grid.ColumnDefinitions>

   <Border Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#101F2F" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="17,15"><StackPanel><TextBlock Text="AFFINER LA RECHERCHE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Vos filtres et raccourcis" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="15">
      <TextBlock Text="MES RACCOURCIS" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/><ItemsControl ItemsSource="{Binding ClientFavoriteFacets}" ItemTemplate="{StaticResource FacetTemplate}"/><Border Background="#0E2231" BorderBrush="#203F56" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,18" Visibility="{Binding HasClientFavorites, Converter={StaticResource InverseBoolVisibility}}"><TextBlock Text="Utilisez l’étoile d’un critère pour le retrouver ici." Style="{StaticResource Caption}"/></Border>
      <TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/><ItemsControl ItemsSource="{Binding ClientUniverseFacets}" ItemTemplate="{StaticResource UniverseTemplate}"/>
      <TextBlock Text="TYPE DE MEUBLE" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientTypeFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
      <TextBlock Text="USAGE" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientUsageFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
      <Button Content="{Binding ClientFilterButtonLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleClientFiltersCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,12"/>
      <StackPanel Visibility="{Binding ShowAdvancedClientFilters, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="FAMILLES" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/><ItemsControl ItemsSource="{Binding ClientFamilyFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
       <TextBlock Text="TAGS" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientTagFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
       <TextBlock Text="FORMES" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientFormFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
       <TextBlock Text="CONSTRUCTION" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientConstructionFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
       <TextBlock Text="ASSEMBLAGE" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientAssemblyFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
       <TextBlock Text="POSITION DU DOS" Style="{StaticResource Eyebrow}" Margin="0,12,0,9"/><ItemsControl ItemsSource="{Binding ClientBackFacets}" ItemTemplate="{StaticResource FacetTemplate}"/>
      </StackPanel>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="2" Background="#101F2F" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="14"><Button Content="Tout effacer" Style="{StaticResource GhostButton}" Command="{Binding ClearClientFiltersCommand}" HorizontalAlignment="Stretch"/></Border>
    </Grid>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#101F2F" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="18,0"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="COLLECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Les meilleures correspondances" FontWeight="SemiBold" FontSize="16" Margin="0,3,0,0"/></StackPanel><Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="13,7"><TextBlock Text="{Binding ClientResultLabel}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/></Border></Grid></Border>
     <Grid Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasClientResults, Converter={StaticResource InverseBoolVisibility}}"><Border Width="86" Height="86" CornerRadius="43" Background="#102638"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="52" Opacity=".2"/></Border><TextBlock Text="Aucun meuble ne correspond à cette combinaison" Style="{StaticResource Caption}" Margin="0,14,0,0"/></StackPanel>
      <ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurnitureCard}" Margin="12" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="248" ItemHeight="306" Spacing="12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource FurnitureCard}" IsChecked="{Binding IsChosen}" Click="FurnitureCard_OnClick"><Grid Margin="11"><Grid.RowDefinitions><RowDefinition Height="176"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PreviewBrush}" BorderBrush="#1D3B50" BorderThickness="1" CornerRadius="10"><Grid><Rectangle Fill="{StaticResource AtlasGridBrush}"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="58" Opacity=".1"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="12"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Pill}" Margin="9"><TextBlock Text="{Binding TypeMeuble}" Foreground="{StaticResource CyanBrush}" FontSize="9"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="3,11,3,0"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Text="{Binding Universes}" Foreground="#82DDF7" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" MaxHeight="35" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Grid></ToggleButton></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Grid>
   </Border>

   <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="225"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0"><Grid><Rectangle Fill="{StaticResource AtlasGridBrush}"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="78" Opacity=".12"/><Image Source="{Binding SelectedClientFurnitureCard.Thumbnail}" Stretch="Uniform" Margin="20"/></Grid></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="SÉLECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Reference}" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Description}" Foreground="#C4D0E1" TextWrapping="Wrap" Margin="0,13,0,0"/>
      <TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}" Margin="0,19,0,5"/><TextBlock Text="{Binding SelectedClientFurniture.UniversesCsv}"/>
      <TextBlock Text="TYPE ET FORME" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock><Run Text="{Binding SelectedClientFurniture.TypeMeuble}"/><Run Text=" · "/><Run Text="{Binding SelectedClientFurniture.Forme}"/></TextBlock>
      <TextBlock Text="USAGES" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientUses}"/>
      <TextBlock Text="TAGS" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientTags}" Foreground="#9FCDF1"/>
      <TextBlock Text="CONCEPTION" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientStructure}"/>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="2" Background="#101F2F" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="15"><StackPanel>
      <Grid Margin="0,0,0,10"><TextBlock Text="{Binding ClientSelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Vider" Style="{StaticResource GhostButton}" Command="{Binding ClearClientSelectionCommand}" HorizontalAlignment="Right" Padding="10,5"/></Grid>
      <Button Content="Ouvrir la passerelle" Command="{Binding PrepareTopSolidBridgeCommand}" HorizontalAlignment="Stretch" ToolTip="Choisir le dossier de travail et y créer les copies"/>
      <Border Visibility="{Binding IsTopSolidBridgeReady, Converter={StaticResource BoolVisibility}}" Background="#0D2C38" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,10,0,0"><StackPanel>
       <TextBlock Text="PASSERELLE PRÊTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TopSolidBridgeCountLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding TopSolidBridgeFolder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopSolidBridgeFolder}" Margin="0,3,0,10"/>
       <Border x:Name="TopSolidDragCapsule" Background="{StaticResource PrimaryGradient}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand" Effect="{StaticResource GlowShadow}" PreviewMouseLeftButtonDown="TopSolidDragCapsule_OnMouseLeftButtonDown" PreviewMouseMove="TopSolidDragCapsule_OnMouseMove"><Grid><TextBlock Text="✦  Glisser vers TopSolid" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="⋮⋮" Foreground="White" Opacity=".75" FontWeight="Bold" HorizontalAlignment="Right"/></Grid></Border>
       <Button Content="Afficher les copies" Style="{StaticResource GhostButton}" Command="{Binding OpenTopSolidBridgeFolderCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/><TextBlock Text="Déposez la capsule dans l’instance TopSolid souhaitée. Atlas ne démarre jamais TopSolid." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </StackPanel></Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
