<UserControl x:Class="Atlas.App.Views.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Atlas.App.Controls">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel>
    <TextBlock Text="CATALOGUE ATLAS" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="Explorer les meubles publiés" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
    <TextBlock Text="Une vue client claire, alimentée uniquement par les fiches validées dans Forge." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
   </StackPanel>
   <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7">
    <TextBlock Text="{Binding PublishedCount, StringFormat='{}{0} meuble(s) publié(s)'}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="15">
    <StackPanel>
     <TextBlock Text="AFFINER LA RECHERCHE" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Recherche" Style="{StaticResource FieldLabel}" Margin="0,15,0,5"/><TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom, usage, famille ou tag"/>
     <TextBlock Text="Univers" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding ClientUniverseOptions}" SelectedItem="{Binding SelectedClientUniverse}"/>
     <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding ClientTypeOptions}" SelectedItem="{Binding SelectedClientType}"/>
     <TextBlock Text="Famille" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding ClientFamilyOptions}" SelectedItem="{Binding SelectedClientFamily}"/>
     <TextBlock Text="Tag" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding ClientTagOptions}" SelectedItem="{Binding SelectedClientTag}"/>
     <Border Background="#102D2D" BorderBrush="#24645C" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,18,0,0"><TextBlock Text="Les données internes de Forge et les brouillons ne sont jamais affichés ici." Style="{StaticResource Caption}" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="10">
     <Grid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="64" Opacity=".12"/><TextBlock Text="Aucun meuble ne correspond aux filtres" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
      <ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurnitureCard}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="260" ItemHeight="260" Spacing="12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="148"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#08111D" CornerRadius="9"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="54" Opacity=".08"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="7"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Pill}" Margin="7"><TextBlock Text="{Binding TypeMeuble}" Foreground="{StaticResource CyanBrush}" FontSize="9"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="2,9,2,0"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Universes}" Foreground="#8FB5FF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <Border Background="#08111D" CornerRadius="9"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="56" Opacity=".08"/><Image Source="{Binding SelectedClientFurnitureCard.Thumbnail}" Stretch="Uniform" Margin="8"/></Grid></Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedClientFurniture.Reference}" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Description}" Foreground="#CBD5E1" TextWrapping="Wrap" MaxHeight="42" Margin="0,10,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.UniversesCsv, StringFormat='Univers : {0}'}" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedClientFurniture.TypeMeuble, StringFormat='Type : {0}'}"/><TextBlock Text="{Binding SelectedClientFurniture.Forme, StringFormat='Forme : {0}'}" Margin="0,7,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.UsageSpecifique, StringFormat='Usages : {0}'}" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Insérer dans TopSolid — prochaine étape" IsEnabled="False" Margin="0,15,0,0"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
