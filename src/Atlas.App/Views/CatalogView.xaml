icResource Eyebrow}" Margin="0,16,0,0"/><TextBlock Text="{Binding SelectedClientTags}" Foreground="#9FCDF1" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="CONCEPTION" Style="{StaticResource Eyebrow}" Margin="0,16,0,0"/><TextBlock Text="{Binding SelectedClientStructure}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></ScrollViewer><Border Grid.Row="2" Background="#101F2F" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="15"><StackPanel><Grid Margin="0,0,0,10"><TextBlock Text="{Binding ClientSelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Vider" Style="{StaticResource GhostButton}" Command="{Binding ClearClientSelectionCommand}" HorizontalAlignment="Right" Padding="10,5"/></Grid><Button Command="{Binding PrepareTopSolidBridgeCommand}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource ArrowGeometry}" Stroke="White" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Préparer dans TopSolid" FontWeight="SemiBold"/></StackPanel></Button><Border Visibility="{Binding IsTopSolidBridgeReady, Converter={StaticResource BoolVisibility}}" Background="#0D2C38" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="PASSERELLE PRÊTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TopSolidBridgeCountLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/><Border x:Name="TopSolidDragCapsule" Background="{StaticResource PrimaryGradient}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="9" Padding="12,10" Cursor="Hand" Margin="0,9,0,0" PreviewMouseLeftButtonDown="TopSolidDragCapsule_OnMouseLeftButtonDown" PreviewMouseMove="TopSolidDragCapsule_OnMouseMove"><TextBlock Text="Glisser vers TopSolid" Foreground="White" FontWeight="Bold" HorizontalAlignment="C