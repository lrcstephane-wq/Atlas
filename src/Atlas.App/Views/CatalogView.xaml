<UserControl x:Class="Atlas.App.Views.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:controls="clr-namespace:Atlas.App.Controls">
 <UserControl.Resources>
  <Geometry x:Key="SearchGeometry">M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 M14,14 L20,20</Geometry>
  <Geometry x:Key="TransferGeometry">M12,3 L12,16 M7,8 L12,3 L17,8 M5,14 L3,14 L3,21 L21,21 L21,14 L19,14</Geometry>

  <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style x:Key="FacetOption" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Row" Background="#41484C" BorderBrush="Transparent" BorderThickness="1" Padding="10,8" Margin="0,0,0,5">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="Mark" Width="15" Height="15" BorderBrush="#778187" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M2,7 L6,11 L13,3" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border>
      <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#4A5358"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Row" Property="Background" Value="#344850"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Mark" Property="Background" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="FacetOptionTemplate">
   <Grid>
    <CheckBox Style="{StaticResource FacetOption}" IsChecked="{Binding IsSelected}"/>
    <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource IconButton}" Width="25" Height="25" MinHeight="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,5" Click="ClientFacetFavorite_OnClick" ToolTip="Ajouter aux favoris"/>
   </Grid>
  </DataTemplate>

  <Style x:Key="SelectedFacetChip" TargetType="CheckBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border Background="#344850" BorderBrush="#477487" BorderThickness="1" CornerRadius="13" Padding="9,5" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}"/><TextBlock Text=" ×" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/></StackPanel></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FavoriteFacetChip" TargetType="CheckBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Chip" Background="#343A3D" BorderBrush="#50595E" BorderThickness="1" CornerRadius="13" Padding="9,5" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="★" Foreground="{StaticResource AmberBrush}" Margin="0,0,5,0"/><TextBlock Text="{Binding Label}"/></StackPanel></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#344850"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="UniverseCard" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Card" Width="158" Height="82" Background="#3A4044" BorderBrush="#555E63" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
     <Grid><Image Source="{Binding Image}" Stretch="UniformToFill"/><Rectangle Fill="#720D1113"/><Border Width="4" Background="{StaticResource CyanBrush}" HorizontalAlignment="Left" Visibility="Collapsed" x:Name="ActiveLine"/>
      <StackPanel VerticalAlignment="Bottom" Margin="11,0,9,9"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Count, StringFormat='{}{0} modèles'}" FontSize="9" Foreground="#CBD1D4" Margin="0,3,0,0"/></StackPanel>
     </Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#7E898F"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="FurnitureCard" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
     <Grid><ContentPresenter/><Border x:Name="Choice" Width="27" Height="27" Background="#CC2C3336" BorderBrush="#788287" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"><Path x:Name="Tick" Data="M5,12 L10,17 L20,7" Stretch="Uniform" Margin="5" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"/></Border></Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#707A7F"/></Trigger><DataTrigger Binding="{Binding IsChosen}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Choice" Property="Background" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="FurnitureChoiceBox" TargetType="CheckBox">
   <Setter Property="Width" Value="27"/><Setter Property="Height" Value="27"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="9"/><Setter Property="ToolTip" Value="Ajouter ou retirer de la sélection"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Shell" Background="#CC2C3336" BorderBrush="#788287" BorderThickness="1"><Path x:Name="Tick" Data="M5,12 L10,17 L20,7" Stretch="Uniform" Margin="5" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <DataTemplate x:Key="FilterPanelTemplate">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="{Binding ActiveClientFilterTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveClientFilterSelectionLabel}" Style="{StaticResource Caption}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="⌖" Style="{StaticResource IconButton}" Command="{Binding PinClientFilterPanelCommand}" ToolTip="Épingler ou libérer ce panneau"/><Button Content="×" Style="{StaticResource IconButton}" Command="{Binding CloseClientFilterPanelCommand}" Margin="5,0,0,0" ToolTip="Fermer"/></StackPanel></Grid>
    <TextBox Grid.Row="1" Text="{Binding ClientFacetSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,9" ToolTip="Rechercher dans cette liste"/>
    <Grid Grid.Row="2" Margin="0,0,0,7"><TextBlock Text="Sélection multiple possible" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="Effacer ce filtre" Style="{StaticResource GhostButton}" Command="{Binding ClearActiveClientFilterCommand}" Visibility="{Binding HasActiveClientFilterSelection, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Right" Padding="7,3" MinHeight="0"/></Grid>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="360"/><Style.Triggers><DataTrigger Binding="{Binding IsClientFilterPanelDocked}" Value="True"><Setter Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ItemsControl ItemsSource="{Binding ActiveClientFilterOptions}" ItemTemplate="{StaticResource FacetOptionTemplate}"/></ScrollViewer>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="520"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330" MinWidth="300" MaxWidth="370"/></Grid.ColumnDefinitions>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="ATLAS / HORIZON" Style="{StaticResource Eyebrow}"/><TextBlock Text="Explorez la collection" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/><TextBlock Text="Recherchez naturellement, puis affinez si nécessaire." Style="{StaticResource Caption}" FontSize="13"/></StackPanel><Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"><TextBlock Text="{Binding ClientResultLabel}" FontWeight="SemiBold"/></Border></Grid>

   <Grid Grid.Row="2" Visibility="{Binding HasFullHorizonAccess, Converter={StaticResource BoolVisibility}}">
    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Path Data="{StaticResource SearchGeometry}" Stroke="#E7ECEE" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Left" Margin="15,0,0,0"/><TextBox x:Name="ClientSearchBox" Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="15" Padding="48,0,14,0" ToolTip="Exemple : meuble évier Blum"/></Grid></Border>
    <Popup IsOpen="{Binding HasClientSearchSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=ClientSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border Width="480" Background="{StaticResource SurfaceAltBrush}" BorderBrush="#68747A" BorderThickness="1" Padding="8" Effect="{StaticResource PanelShadow}">
      <StackPanel><TextBlock Text="SUGGESTIONS" Style="{StaticResource Eyebrow}" Margin="9,5,9,6"/><ItemsControl ItemsSource="{Binding ClientSearchSuggestions}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,7" Click="ClientSearchSuggestion_OnClick"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </Border>
    </Popup>
   </Grid>
   <Border Grid.Row="2" Visibility="{Binding HasFullHorizonAccess, Converter={StaticResource InverseBoolVisibility}}" Background="#454137" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" Padding="14,9"><StackPanel Orientation="Horizontal"><TextBlock Text="LICENCE REQUISE" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,0,12,0"/><TextBlock Text="Catalogue en consultation uniquement. Ajoutez votre code dans Paramètres > Licence."/></StackPanel></Border>

   <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding HasFullHorizonAccess, Converter={StaticResource BoolVisibility}}">
    <Grid Margin="0,0,0,7"><TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Cliquez pour filtrer · sélection multiple" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Padding="9"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ClientUniverseFacets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid><CheckBox Style="{StaticResource UniverseCard}" IsChecked="{Binding IsSelected}"/><Button Content="{Binding FavoriteGlyph}" Style="{StaticResource IconButton}" Width="25" Height="25" MinHeight="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,13,0" Background="#CC2C3336" Click="ClientFacetFavorite_OnClick" ToolTip="Ajouter aux favoris"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
   </StackPanel>

   <Grid Grid.Row="4" x:Name="FilterToolbar" Margin="0,9,0,0" Visibility="{Binding HasFullHorizonAccess, Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel>
     <Button Content="{Binding ClientTypeFilterLabel}" Style="{StaticResource FilterButton}" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Types"/>
     <Button Content="{Binding ClientUsageFilterLabel}" Style="{StaticResource FilterButton}" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Usages"/>
     <Button Content="{Binding ClientAtlasTagFilterLabel}" Style="{StaticResource FilterButton}" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Tags Atlas"/>
     <Button Content="{Binding ClientUniverseFilterLabel}" Style="{StaticResource FilterButton}" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Univers Client"/>
     <Button Content="{Binding ClientPersonalTagFilterLabel}" Style="{StaticResource FilterButton}" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Tags Client"/>
     <Button x:Name="MoreFiltersButton" Content="{Binding ClientMoreFiltersLabel}" Style="{StaticResource FilterButton}" Click="OpenMoreFilters_OnClick"/>
    </WrapPanel>
    <Button Grid.Column="1" Content="Tout effacer" Style="{StaticResource GhostButton}" Command="{Binding ClearClientFiltersCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6"/>
   </Grid>

   <StackPanel Grid.Row="5" Margin="0,7,0,0">
    <Grid Visibility="{Binding HasClientFavorites, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
     <TextBlock Text="FAVORIS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
     <ItemsControl ItemsSource="{Binding ClientFavoriteFacets}" Margin="60,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource FavoriteFacetChip}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
    <Grid><ItemsControl ItemsSource="{Binding SelectedClientFacets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource SelectedFacetChip}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ClientSearchInterpretation}" Visibility="{Binding HasClientSearchInterpretation, Converter={StaticResource BoolVisibility}}" Foreground="#8ECFE8" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
   </StackPanel>

   <Grid Grid.Row="6" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="286" Margin="0,0,10,0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13" Visibility="{Binding IsClientFilterPanelDocked, Converter={StaticResource BoolVisibility}}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilterPanelTemplate}"/></Border>
    <Border Grid.Column="1" Background="#2A2F32" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Padding="8"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasClientResults, Converter={StaticResource InverseBoolVisibility}}"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="48" Opacity=".16"/><TextBlock Text="Aucun meuble ne correspond à cette combinaison" Style="{StaticResource Caption}" Margin="0,11,0,0"/></StackPanel><ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurnitureCard}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="235" ItemHeight="278" Spacing="9"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid><Button Style="{StaticResource FurnitureCard}" Click="FurnitureCard_OnClick" MouseDoubleClick="FurnitureCard_OnMouseDoubleClick" ToolTip="{Binding SearchExplanation}"><Grid><Grid.RowDefinitions><RowDefinition Height="184"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PreviewBrush}"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="45" Opacity=".07"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Pill}" Margin="8" Padding="7,4" Background="#CC2C3336"><TextBlock Text="{Binding CardBadge}" FontSize="9"/></Border></Grid></Border><Grid Grid.Row="1" Margin="11,9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Grid.Row="1" Text="{Binding Reference}" Foreground="{StaticResource CyanBrush}" FontSize="10" Margin="0,4,0,0"/><TextBlock Grid.Row="2" Text="{Binding SourceLabel}" Style="{StaticResource Caption}" FontSize="9" VerticalAlignment="Bottom"/></Grid></Grid></Button><CheckBox Style="{StaticResource FurnitureChoiceBox}" IsChecked="{Binding IsChosen}" Click="FurnitureChoice_OnClick"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
   </Grid>

   <Popup x:Name="MoreFiltersPopup" PlacementTarget="{Binding ElementName=MoreFiltersButton}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Width="238" Background="{StaticResource SurfaceAltBrush}" BorderBrush="#68747A" BorderThickness="1" Padding="8" Effect="{StaticResource PanelShadow}"><StackPanel><TextBlock Text="AUTRES FILTRES" Style="{StaticResource Eyebrow}" Margin="8,5,8,8"/><Button Content="Famille" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Familles"/><Button Content="Source" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Source"/><Button Content="Forme" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Formes"/><Button Content="Construction" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Construction"/><Button Content="Assemblage" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Assemblage"/><Button Content="Dos" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenClientFilterPanelCommand}" CommandParameter="Dos"/></StackPanel></Border></Popup>
   <Popup IsOpen="{Binding IsClientFilterPanelOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FilterToolbar}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Width="360" Background="{StaticResource SurfaceAltBrush}" BorderBrush="#68747A" BorderThickness="1" Padding="14" Effect="{StaticResource PanelShadow}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilterPanelTemplate}"/></Border></Popup>
  </Grid>

  <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Visibility="{Binding HasMultipleClientSelection, Converter={StaticResource InverseBoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120" MaxHeight="220"/><RowDefinition Height="1.35*"/></Grid.RowDefinitions>
     <Border Padding="17,15" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding SelectedClientFurnitureCard.SourceLabel}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.TypeMeuble}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Grid.Row="1" Background="{StaticResource PreviewBrush}" Margin="14,12,14,0"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="60" Opacity=".07"/><Image Source="{Binding SelectedClientFurnitureCard.Thumbnail}" Stretch="Uniform" Margin="11"/></Grid></Border>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="17,14"><Border Background="#394348" BorderBrush="#586267" BorderThickness="1" Padding="11,8"><Grid><StackPanel><TextBlock Text="{Binding SelectedClientFurnitureCard.ReferenceCaption}" Style="{StaticResource Eyebrow}"/><TextBlock Text="Identifiant unique dans Horizon" Style="{StaticResource Caption}"/></StackPanel><TextBlock Text="{Binding SelectedClientFurniture.Reference}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><StackPanel Visibility="{Binding SelectedClientIsCustomerFurniture, Converter={StaticResource BoolVisibility}}"><TextBlock Text="TAGS CLIENT" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Text="{Binding SelectedClientPersonalTags}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><TextBlock Text="{Binding SelectedClientFurniture.Description}" Foreground="#D0D5D7" TextWrapping="Wrap" Margin="0,12,0,2"/><TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.UniversesCsv}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="TYPE ET FORME" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Margin="0,4,0,0"><Run Text="{Binding SelectedClientFurniture.TypeMeuble}"/><Run Text=" · "/><Run Text="{Binding SelectedClientFurniture.Forme}"/></TextBlock><TextBlock Text="USAGES" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Text="{Binding SelectedClientUses}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="TAGS ATLAS" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Text="{Binding SelectedClientTags}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="CONCEPTION" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/><TextBlock Text="{Binding SelectedClientStructure}" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel Visibility="{Binding HasSelectedClientComposition, Converter={StaticResource BoolVisibility}}"><TextBlock Text="COMPOSITION DU MEUBLE" Style="{StaticResource Eyebrow}" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedClientCompositionLabel}" Style="{StaticResource Caption}" Margin="0,3,0,6"/><ItemsControl ItemsSource="{Binding SelectedClientCompositionLines}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#373D41" BorderBrush="#4B5358" BorderThickness="1" Padding="9,7" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Family}" Style="{StaticResource Caption}"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" VerticalAlignment="Center"><Run Text="× "/><Run Text="{Binding Quantity}"/></TextBlock></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></ScrollViewer>
    </Grid>
    <Grid Visibility="{Binding HasMultipleClientSelection, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="17,15" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1"><Grid><StackPanel><TextBlock Text="SÉLECTION MULTIPLE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ClientSelectionLabel}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button Content="Vider" Style="{StaticResource GhostButton}" Command="{Binding ClearClientSelectionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ClientSelectionItems}" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Margin="0,0,0,7" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Height="54" Background="{StaticResource PreviewBrush}"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="10,2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Reference}" Foreground="{StaticResource CyanBrush}" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Caption}"/></StackPanel><Button Grid.Column="2" Content="×" Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveClientSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Retirer de la sélection"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
    <Border Grid.Row="1" Visibility="{Binding HasFullHorizonAccess, Converter={StaticResource BoolVisibility}}" Background="#292E31" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="13"><StackPanel><Grid Margin="0,0,0,8"><TextBlock Text="{Binding ClientSelectionLabel}" FontWeight="SemiBold"/><Button Content="Vider" Style="{StaticResource GhostButton}" Command="{Binding ClearClientSelectionCommand}" HorizontalAlignment="Right" Padding="8,4"/></Grid><Button Command="{Binding PrepareTopSolidBridgeCommand}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource TransferGeometry}" Stroke="White" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="{Binding PrepareClientSelectionLabel}"/></StackPanel></Button><Border Visibility="{Binding IsTopSolidBridgeReady, Converter={StaticResource BoolVisibility}}" Background="#344850" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" Padding="9" Margin="0,7,0,0"><StackPanel><TextBlock Text="{Binding TopSolidBridgeCountLabel}" FontWeight="SemiBold"/><Border x:Name="TopSolidDragCapsule" Background="{StaticResource PrimaryGradient}" Padding="10,8" Cursor="Hand" Margin="0,6,0,0" PreviewMouseLeftButtonDown="TopSolidDragCapsule_OnMouseLeftButtonDown" PreviewMouseMove="TopSolidDragCapsule_OnMouseMove"><TextBlock Text="Glisser vers TopSolid" HorizontalAlignment="Center" FontWeight="Bold"/></Border><Button Content="Afficher les copies" Style="{StaticResource GhostButton}" Command="{Binding OpenTopSolidBridgeFolderCommand}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>
