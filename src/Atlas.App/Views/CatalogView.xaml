<UserControl x:Class="Atlas.App.Views.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Aperçu du Catalogue Atlas" Style="{StaticResource PageTitle}"/><TextBlock Text="Une première projection de l’expérience destinée au client. Seuls les meubles publiés sont visibles." Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,18"/></StackPanel>
        <TextBox Grid.Row="1" Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher par nom, famille ou usage" Height="42" Margin="0,0,0,16"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurniture}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,6,10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="62" Height="62" CornerRadius="10" Background="#E4EDFB"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Margin="11"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Family}" Style="{StaticResource Caption}" Margin="0,3,0,0"/><TextBlock Text="{Binding UseCasesCsv}" Foreground="{StaticResource BlueBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Reference}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                <Border Height="190" Background="#EAF0F8" CornerRadius="10"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="112" Opacity="0.75"/></Border>
                <TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,4"/>
                <TextBlock Text="{Binding SelectedClientFurniture.Reference}" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedClientFurniture.Description}" Margin="0,15,0,16"/>
                <TextBlock Text="Usages" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedClientFurniture.UseCasesCsv}" Margin="0,4,0,14"/>
                <TextBlock Text="Principe de construction" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedClientFurniture.PrincipleConstruction}" Margin="0,4,0,18"/>
                <Button Content="Glisser vers TopSolid — bientôt" IsEnabled="False"/>
                <TextBlock Text="Le glisser-déposer sera activé lorsque la fiche meuble sera reliée à son .TOP opaque." Style="{StaticResource Caption}" Margin="0,9,0,0"/>
            </StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
