<UserControl x:Class="Atlas.App.Views.CatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Atlas.App.Controls">
 <UserControl.Resources>
  <Style x:Key="HorizonFacet" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Chip" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="12,7" Margin="0,0,7,7"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><Border Background="{StaticResource RaisedBrush}" CornerRadius="9" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="{Binding CountLabel}" FontSize="9" Foreground="{StaticResource MutedBrush}"/></Border></StackPanel></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HorizonUniverse" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="178"/><Setter Property="Height" Value="78"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Card" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,10,10"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding Count, StringFormat='{}{0} meuble(s)'}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Border x:Name="TickBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource CobaltBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold"/></Border></Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="TickBadge" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HorizonFurnitureCard" TargetType="ToggleButton">
   <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><Grid><ContentPresenter/><Border x:Name="Choice" Width="30" Height="30" CornerRadius="7" Background="{StaticResource FieldBrush}" BorderBrush="#49617F" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><TextBlock x:Name="Tick" Text="✓" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="Choice" Property="Background" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FacetStar" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource FieldBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Épingler dans mes raccourcis"/>
  </Style>
  <DataTemplate x:Key="HorizonFacetTemplate">
   <StackPanel Orientation="Horizontal" Margin="0,0,5,6">
    <CheckBox Style="{StaticResource HorizonFacet}" IsChecked="{Binding IsSelected}" Margin="0"/>
    <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource FacetStar}" Click="ClientFacetFavorite_OnClick" Margin="-4,0,0,7" VerticalAlignment="Center"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="HorizonUniverseTemplate">
   <Grid Margin="0,0,10,10">
    <CheckBox Style="{StaticResource HorizonUniverse}" IsChecked="{Binding IsSelected}" Margin="0"/>
    <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource FacetStar}" Click="ClientFacetFavorite_OnClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,13,12"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource HeroGradient}" CornerRadius="14" Padding="26,19" MinHeight="140" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="ATLAS / HORIZON" Style="{StaticResource Eyebrow}"/><TextBlock Text="Explorez la collection" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Décrivez votre besoin — Horizon comprend aussi les approximations." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,14"/>
     <Border Background="{StaticResource FieldBrush}" BorderBrush="#3C6589" BorderThickness="1" CornerRadius="14" Height="54" MaxWidth="920" HorizontalAlignment="Stretch"><Grid><TextBlock Text="⌕" FontSize="26" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="16,0,0,3"/><TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="16" Padding="54,0,14,0" ToolTip="Rechercher librement : meuble évier, four micro-ondes, rangement coulissant… Les petites fautes sont tolérées."/></Grid></Border>
     <TextBlock Text="{Binding ClientSearchInterpretation}" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="8,7,0,0" Visibility="{Binding HasClientSearchInterpretation, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
    <Grid Grid.Column="1"><Ellipse Width="118" Height="118" Fill="{StaticResource SurfaceAltBrush}" Opacity=".55" HorizontalAlignment="Right"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="76" Opacity=".48" HorizontalAlignment="Right" Margin="0,0,21,0"/><Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="13,7"><TextBlock Text="{Binding PublishedCount, StringFormat='{}{0} meuble(s) disponible(s)'}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/></Border></Grid>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MES RACCOURCIS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/><ItemsControl ItemsSource="{Binding ClientFavoriteFacets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,7,0"><CheckBox Style="{StaticResource HorizonFacet}" IsChecked="{Binding IsSelected}"/><Button Content="★" Style="{StaticResource FacetStar}" Click="ClientFacetFavorite_OnClick" Margin="-8,0,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Épinglez les critères utiles avec ☆" Style="{StaticResource Caption}" VerticalAlignment="Center" Visibility="{Binding HasClientFavorites, Converter={StaticResource InverseBoolVisibility}}"/></StackPanel>
    <Button Grid.Column="1" Content="{Binding ClientFilterButtonLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleClientFiltersCommand}" Margin="10,0,0,0"/>
    <Button Grid.Column="2" Content="Tout effacer" Style="{StaticResource GhostButton}" Command="{Binding ClearClientFiltersCommand}" Margin="8,0,0,0"/>
    <Border Grid.Column="3" Style="{StaticResource Pill}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="13,8"><TextBlock Text="{Binding ClientResultLabel}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/></Border>
   </Grid>

   <StackPanel Grid.Row="1" Margin="0,15,0,0"><Grid><TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Plusieurs choix possibles" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,9,0,0"><ItemsControl ItemsSource="{Binding ClientUniverseFacets}" ItemTemplate="{StaticResource HorizonUniverseTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel>

   <Grid Grid.Row="2" Margin="0,4,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="TYPE DE MEUBLE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ClientTypeFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="USAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ClientUsageFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
   </Grid>

   <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,7,0,12" MaxHeight="220" Visibility="{Binding ShowAdvancedClientFilters, Converter={StaticResource BoolVisibility}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="FAMILLES" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ClientFamilyFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="FORMES" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/><ItemsControl ItemsSource="{Binding ClientFormFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="TAGS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ClientTagFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="CONSTRUCTION" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/><ItemsControl ItemsSource="{Binding ClientConstructionFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="ASSEMBLAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ClientAssemblyFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="POSITION DU DOS" Style="{StaticResource Eyebrow}" Margin="0,13,0,8"/><ItemsControl ItemsSource="{Binding ClientBackFacets}" ItemTemplate="{StaticResource HorizonFacetTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
   </Grid></ScrollViewer></Border>

   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="10"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="62" Opacity=".1"/><TextBlock Text="Aucun meuble ne correspond à cette combinaison" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
     <ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurnitureCard}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="270" ItemHeight="300" Spacing="12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource HorizonFurnitureCard}" IsChecked="{Binding IsChosen}" Click="FurnitureCard_OnClick"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="176"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PreviewBrush}" CornerRadius="8"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="55" Opacity=".08"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Pill}" Margin="8"><TextBlock Text="{Binding TypeMeuble}" Foreground="{StaticResource CyanBrush}" FontSize="9"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="2,10,2,0"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Universes}" Foreground="{StaticResource CyanBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Grid></ToggleButton></DataTemplate></ListBox.ItemTemplate>
     </ListBox></Grid></Border>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource PreviewBrush}" CornerRadius="11,11,0,0"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="75" Opacity=".08"/><Image Source="{Binding SelectedClientFurnitureCard.Thumbnail}" Stretch="Uniform" Margin="18"/></Grid></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="19"><TextBlock Text="SÉLECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Reference}" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Description}" Foreground="#C4D0E1" TextWrapping="Wrap" Margin="0,13,0,0"/><TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}" Margin="0,18,0,5"/><TextBlock Text="{Binding SelectedClientFurniture.UniversesCsv}"/><TextBlock Text="TYPE ET FORME" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock><Run Text="{Binding SelectedClientFurniture.TypeMeuble}"/><Run Text=" · "/><Run Text="{Binding SelectedClientFurniture.Forme}"/></TextBlock><TextBlock Text="USAGES" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientUses}"/><TextBlock Text="TAGS" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientTags}" Foreground="#9FC4FF"/><TextBlock Text="CONCEPTION" Style="{StaticResource Eyebrow}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedClientStructure}"/></StackPanel></ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14"><StackPanel>
      <Grid Margin="0,0,0,10"><TextBlock Text="{Binding ClientSelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Vider" Style="{StaticResource GhostButton}" Command="{Binding ClearClientSelectionCommand}" HorizontalAlignment="Right" Padding="10,5"/></Grid>
      <Button Content="Ouvrir la passerelle" Command="{Binding PrepareTopSolidBridgeCommand}" HorizontalAlignment="Stretch" ToolTip="Choisir le dossier de travail et y créer les copies"/>
      <Border Visibility="{Binding IsTopSolidBridgeReady, Converter={StaticResource BoolVisibility}}" Background="#0E2D39" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,0"><StackPanel>
       <TextBlock Text="PASSERELLE PRÊTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TopSolidBridgeCountLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding TopSolidBridgeFolder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopSolidBridgeFolder}" Margin="0,3,0,10"/>
       <Border x:Name="TopSolidDragCapsule" Background="{StaticResource PrimaryGradient}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11" Cursor="Hand" Effect="{StaticResource GlowShadow}" PreviewMouseLeftButtonDown="TopSolidDragCapsule_OnMouseLeftButtonDown" PreviewMouseMove="TopSolidDragCapsule_OnMouseMove"><Grid><TextBlock Text="✦  Glisser vers TopSolid" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="⋮⋮" Foreground="White" Opacity=".75" FontWeight="Bold" HorizontalAlignment="Right"/></Grid></Border>
       <Button Content="Afficher les copies" Style="{StaticResource GhostButton}" Command="{Binding OpenTopSolidBridgeFolderCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
       <TextBlock Text="Déposez la capsule dans l’instance TopSolid souhaitée. Atlas ne démarre jamais TopSolid." Foreground="#9CB2CE" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </StackPanel></Border>
    </Grid></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
