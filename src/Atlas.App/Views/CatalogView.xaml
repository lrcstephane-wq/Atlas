<UserControl x:Class="Atlas.App.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Atlas.App.Controls">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource HeroGradient}" CornerRadius="14" Padding="26" Margin="0,0,0,14">
   <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="BIBLIDÉO ATLAS / EXPÉRIENCE CLIENT" Style="{StaticResource Eyebrow}" Foreground="#B7FFF5"/><TextBlock Text="Le bon meuble, au bon endroit." FontSize="31" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Une vue claire, visuelle et filtrable du catalogue publié — sans exposer les données internes de Forge." Foreground="#C8D7EB" FontSize="13"/></StackPanel><Border HorizontalAlignment="Right" Width="210" Height="92" CornerRadius="46" Background="#27101A2A"><Grid><Ellipse Stroke="#488BDD" StrokeThickness="1" Width="82" Height="82" Opacity=".6"/><Ellipse Stroke="#2DD4BF" StrokeThickness="2" Width="54" Height="54" Opacity=".75"/><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="44" Opacity=".75"/></Grid></Border></Grid>
  </Border>
  <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="205"/><ColumnDefinition Width="205"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher un meuble, un usage ou une famille" Height="40" Margin="0,0,8,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding ClientUniverseOptions}" SelectedItem="{Binding SelectedClientUniverse}" Height="40" Margin="0,0,8,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding ClientTypeOptions}" SelectedItem="{Binding SelectedClientType}" Height="40" Margin="0,0,8,0"/><Border Grid.Column="3" Style="{StaticResource Pill}" VerticalAlignment="Center"><TextBlock Text="{Binding PublishedCount, StringFormat='{}{0} publiés'}" Foreground="{StaticResource CyanBrush}"/></Border></Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding ClientFurnitureView}" SelectedItem="{Binding SelectedClientFurnitureCard}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="275" ItemHeight="276" Spacing="12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceAltBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0D1725" CornerRadius="9"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="64" Opacity=".1"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Pill}" Margin="8"><TextBlock Text="{Binding TypeMeuble}" Foreground="{StaticResource CyanBrush}" FontSize="9"/></Border></Grid></Border><Grid Grid.Row="1" Margin="2,10,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Row="1" Text="{Binding Universes}" Foreground="#8FB5FF" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Text="{Binding Reference}" Style="{StaticResource Caption}" VerticalAlignment="Bottom"/></Grid></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="235"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#0B1421" CornerRadius="13,13,0,0"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="100" Opacity=".1"/><Image Source="{Binding SelectedClientFurnitureCard.Thumbnail}" Stretch="Uniform" Margin="18"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="{Binding SelectedClientFurniture.DisplayName}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedClientFurniture.Reference}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.Description}" Foreground="#CBD5E1" Margin="0,15,0,18"/><TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.UniversesCsv}" Margin="0,5,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TYPE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.TypeMeuble}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FORME" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedClientFurniture.Forme}" Margin="0,5,0,0"/></StackPanel></Grid><TextBlock Text="USAGE" Style="{StaticResource Eyebrow}" Margin="0,16,0,0"/><TextBlock Text="{Binding SelectedClientFurniture.UsageSpecifique}" Margin="0,5,0,0"/><Border Background="#10233A" BorderBrush="#244D79" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,17,0,0"><TextBlock Text="La fiche client utilise uniquement les informations validées et publiées par Forge." Style="{StaticResource Caption}"/></Border></StackPanel></ScrollViewer><Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="15"><StackPanel><Button Content="Insérer dans TopSolid — prochaine étape" IsEnabled="False"/><TextBlock Text="Le fichier restera opaque : Atlas transmettra son chemin contrôlé." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
