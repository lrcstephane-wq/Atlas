<UserControl x:Class="Atlas.App.Views.ComponentsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Forge · Fiches composants" Style="{StaticResource PageTitle}"/><TextBlock Text="Indexation opaque des .TOP, enrichissement métier et validation humaine." Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,18"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding ComponentSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher par nom, bibliothèque, famille ou type" Height="39" />
            <Button Grid.Column="1" Content="Choisir la bibliothèque" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLibraryCommand}" Margin="10,0,0,0" />
            <Button Grid.Column="2" Content="Indexer les .TOP" Command="{Binding ScanCommand}" Margin="10,0,0,0" />
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding ComponentView}" SelectedItem="{Binding SelectedComponent}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="Bibliothèque" Binding="{Binding LibraryName}" Width="*" />
                    <DataGridTextColumn Header="Famille" Binding="{Binding FamilyName}" Width="*" />
                    <DataGridTextColumn Header="État" Binding="{Binding Status, Converter={StaticResource StatusLabel}}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Fiche composant" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SelectedComponent.Classification}" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,16" />
                        <TextBlock Text="Nom affiché" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <TextBlock Text="Fonction" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.Function, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <TextBlock Text="Description" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Margin="0,4,0,10"/>
                        <TextBlock Text="Conseils d’utilisation" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.UsageNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" Margin="0,4,0,10"/>
                        <TextBlock Text="Capacités transmises au meuble (séparées par des virgules)" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.CapabilitiesCsv, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <TextBlock Text="Compatibilités transmises au meuble" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.CompatibilityCsv, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <Border Background="#F6F8FB" CornerRadius="8" Padding="12" Margin="0,6,0,12"><StackPanel><TextBlock Text="Provenance automatique" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedComponent.SourceRelativePath}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedComponent.TechnicalName}" Style="{StaticResource Caption}"/></StackPanel></Border>
                        <TextBlock Text="Motif de validation forcée" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedComponent.ForcedValidationReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <Button Content="Valider cette fiche" Command="{Binding ValidateComponentCommand}" IsEnabled="{Binding CanValidate}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
