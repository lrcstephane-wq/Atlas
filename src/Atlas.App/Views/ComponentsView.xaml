<UserControl x:Class="Atlas.App.Views.ComponentsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Atlas.App.Controls"
 Loaded="ComponentsView_OnLoaded" IsVisibleChanged="ComponentsView_OnIsVisibleChanged">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <StackPanel><TextBlock Text="FORGE / COMPOSANTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Bibliothèque vivante" Style="{StaticResource PageTitle}"/><TextBlock Text="Repérez, filtrez et enrichissez les composants TopSolid sans ouvrir ni interpréter les fichiers .TOP." Style="{StaticResource Caption}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Choisir la bibliothèque" Style="{StaticResource GhostButton}" Command="{Binding ChooseLibraryCommand}" Margin="0,0,8,0"/><Button Content="Indexer maintenant" Command="{Binding ScanCommand}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="520"/><ColumnDefinition Width="8"/><ColumnDefinition Width="460" MinWidth="420" MaxWidth="680"/></Grid.ColumnDefinitions>

   <Border Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="16,14"><TextBlock Text="BIBLIOTHÈQUES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Sources détectées" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding SelectedLibraryFilter}" Margin="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource SelectionHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border HorizontalAlignment="Right" Style="{StaticResource Pill}" Padding="7,2"><TextBlock Text="{Binding CountLabel}" Style="{StaticResource Caption}"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Grid.Row="2" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14"><StackPanel><TextBlock Text="Sélection de travail" FontWeight="SemiBold"/><TextBlock Text="{Binding MarkedComponentCount, StringFormat='{}{0} composant(s) coché(s)'}" Style="{StaticResource Caption}" Margin="0,3,0,8"/><Button Content="Affecter des tags" Click="OpenBulkTags_OnClick"/><Button Content="Valider les fiches" Style="{StaticResource SecondaryButton}" Margin="0,7,0,0" Click="ValidateMarkedComponents_OnClick"/><Button Content="Tout décocher" Style="{StaticResource GhostButton}" Command="{Binding ClearMarkedComponentsCommand}" Margin="0,7,0,0"/></StackPanel></Border>
    </Grid>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding ComponentSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom, famille, type ou bibliothèque" Height="40" Margin="0,0,8,0"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding ComponentTypeOptions}" SelectedItem="{Binding SelectedComponentType}" Height="40" Margin="0,0,8,0"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="▦" Style="{StaticResource IconButton}" Command="{Binding SetComponentLayoutCommand}" CommandParameter="Mosaic" ToolTip="Vue mosaïque" Margin="0,0,5,0"/><Button Content="☷" Style="{StaticResource IconButton}" Command="{Binding SetComponentLayoutCommand}" CommandParameter="List" ToolTip="Vue liste"/></StackPanel>
     </Grid>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,8"><ItemsControl ItemsSource="{Binding FamilyFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Background="{Binding Background}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0" Command="{Binding DataContext.SetFamilyFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Label}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Count, StringFormat='  {0}'}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Grid Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="{Binding VisibleComponentLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Sélectionner les visibles" Style="{StaticResource GhostButton}" Padding="10,5" Command="{Binding SelectVisibleComponentsCommand}"/><Button Content="Réinitialiser" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Command="{Binding ClearComponentFiltersCommand}"/></StackPanel></Grid>

     <ListBox Grid.Row="3" ItemsSource="{Binding ComponentView}" SelectedItem="{Binding SelectedComponentCard}" SelectionChanged="ComponentSelection_OnChanged" PreviewMouseLeftButtonUp="ComponentItem_OnPreviewMouseLeftButtonUp" Visibility="{Binding IsComponentMosaic, Converter={StaticResource BoolVisibility}}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="245" ItemHeight="218" Spacing="10"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Outer" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Margin="0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource CobaltBrush}"/><Setter TargetName="Outer" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PreviewBrush}" CornerRadius="8"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="55" Opacity=".12"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="5"/><CheckBox IsChecked="{Binding IsMarked}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/><Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"><TextBlock Text="{Binding Type}" FontSize="9" Foreground="{StaticResource CyanBrush}"/></Border></Grid></Border><Grid Grid.Row="1" Margin="2,9,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Row="1" Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,5,0,0"/></Grid></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>

     <DataGrid Grid.Row="3" ItemsSource="{Binding ComponentView}" SelectedItem="{Binding SelectedComponentCard}" SelectionChanged="ComponentSelection_OnChanged" PreviewMouseLeftButtonUp="ComponentItem_OnPreviewMouseLeftButtonUp" AutoGenerateColumns="False" IsReadOnly="True" Visibility="{Binding IsComponentMosaic, Converter={StaticResource InverseBoolVisibility}}"><DataGrid.Columns><DataGridTemplateColumn Header="" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsMarked}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Aperçu" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="56" Height="38" Background="{StaticResource PreviewBrush}" CornerRadius="5"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Composant" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Bibliothèque" Binding="{Binding Library}" Width="*"/><DataGridTextColumn Header="Famille" Binding="{Binding Family}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/></DataGrid.Columns></DataGrid>
     <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,10,0,0"><Grid><TextBlock Text="Les composants cochés restent mémorisés pendant votre travail." Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="Utiliser dans le meuble" HorizontalAlignment="Right" Command="{Binding NavigateCommand}" CommandParameter="Furniture" Padding="10,5"/></Grid></Border>
    </Grid>
   </Border>

   <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
   <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="SingleModeButton" Content="Fiche sélectionnée" Click="ShowSingleMode_OnClick" Margin="0,0,5,0"/>
       <Button x:Name="BulkModeButton" Grid.Column="1" Content="Action groupée" Style="{StaticResource GhostButton}" Click="ShowBulkMode_OnClick" Margin="5,0,0,0"/>
      </Grid>
     </Border>

     <Grid x:Name="SingleEditorPanel" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="154"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{StaticResource PreviewBrush}"><Grid><Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="76" Opacity=".1"/><Image Source="{Binding SelectedComponentCard.Thumbnail}" Stretch="Uniform" Margin="15"/><Border Background="#DC07111D" VerticalAlignment="Bottom" Padding="15,10"><StackPanel><TextBlock Text="{Binding SelectedComponent.DisplayName}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding SelectedComponent.Classification}" Foreground="{StaticResource CyanBrush}" FontSize="10"/></StackPanel></Border></Grid></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" IsEnabled="{Binding CanEdit}">
       <TextBlock Text="FICHE COMPOSANT" Style="{StaticResource Eyebrow}"/>
       <TextBlock Text="Nom affiché" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedComponent.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

       <TextBlock Text="CLASSIFICATION" Style="{StaticResource Eyebrow}" Margin="0,18,0,9"/>
       <TextBlock Text="Famille détectée dans Biblidéo" Style="{StaticResource FieldLabel}"/>
       <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8"><TextBlock x:Name="DetectedFamilyText" Foreground="{StaticResource MutedBrush}"/></Border>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Famille Atlas" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AtlasFamilyCombo" IsEditable="False" IsTextSearchEnabled="True" SelectionChanged="AtlasFamilyCombo_OnSelectionChanged"/></StackPanel><Button Grid.Column="1" Content="↺" Style="{StaticResource IconButton}" Margin="7,20,0,0" VerticalAlignment="Bottom" ToolTip="Reprendre la famille détectée" Click="ResetFamily_OnClick"/></Grid>
       <TextBlock x:Name="FamilyOverrideHint" Text="Dérogation active : la famille Atlas diffère de l’architecture Biblidéo." Foreground="{StaticResource AmberBrush}" FontSize="10" Margin="0,6,0,0" Visibility="Collapsed"/>

       <Grid Margin="0,20,0,7"><TextBlock Text="TAGS DU COMPOSANT" Style="{StaticResource Eyebrow}"/><Button Content="↻" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Recharger les tags des paramètres" Click="ReloadTags_OnClick"/></Grid>
       <TextBlock x:Name="SingleTagSummary" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
       <TextBox x:Name="SingleTagSearch" TextChanged="SingleTagSearch_OnChanged" ToolTip="Rechercher un tag" Margin="0,0,0,9"/>
       <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="9">
        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
         <ItemsControl x:Name="SingleTagList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource ChipCheck}" IsChecked="{Binding IsSelected}"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
       </Border>
       <TextBlock x:Name="NoTagsText" Text="Aucun tag actif. Créez vos tags dans Paramètres › Forge › Tags." Style="{StaticResource Caption}" Margin="0,7,0,0"/>

       <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,17,0,5"/><TextBox Text="{Binding SelectedComponent.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="62"/>
       <TextBlock Text="Conseils d’utilisation" Style="{StaticResource FieldLabel}" Margin="0,11,0,5"/><TextBox Text="{Binding SelectedComponent.UsageNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="52"/>
       <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="10" Margin="0,14,0,0"><StackPanel><TextBlock Text="PROVENANCE AUTOMATIQUE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedComponent.SourceRelativePath}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedComponent.TechnicalName}" Style="{StaticResource Caption}"/></StackPanel></Border>
       <TextBlock Text="Motif de validation forcée" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedComponent.ForcedValidationReason, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel></ScrollViewer>
     </Grid>

     <Grid x:Name="BulkEditorPanel" Grid.Row="1" Visibility="Collapsed" Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="AFFECTATION EN MASSE" Style="{StaticResource Eyebrow}"/>
       <TextBlock Text="{Binding MarkedComponentCount, StringFormat='{}{0} composant(s) dans la sélection'}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,3"/>
       <TextBlock Text="Choisissez un ou plusieurs tags, puis ajoutez-les ou retirez-les de tous les composants cochés." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
      </StackPanel>
      <TextBox x:Name="BulkTagSearch" Grid.Row="1" TextChanged="BulkTagSearch_OnChanged" ToolTip="Rechercher un tag" Margin="0,16,0,9"/>
      <Border Grid.Row="2" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="BulkTagList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource ChipCheck}" IsChecked="{Binding IsSelected}"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
      </Border>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
       <TextBlock x:Name="BulkTagSummary" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
       <Button x:Name="BulkAddButton" Content="Ajouter les tags à la sélection" Click="BulkAddTags_OnClick"/>
       <Button x:Name="BulkRemoveButton" Content="Retirer les tags de la sélection" Style="{StaticResource GhostButton}" Margin="0,7,0,0" Click="BulkRemoveTags_OnClick"/>
      </StackPanel>
     </Grid>

     <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14"><Button x:Name="ValidateSingleComponentButton" Content="Valider cette fiche" Command="{Binding ValidateComponentCommand}" IsEnabled="{Binding CanValidate}" HorizontalAlignment="Stretch"/></Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
