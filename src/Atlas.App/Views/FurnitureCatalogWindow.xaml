<Window x:Class="Atlas.App.Views.FurnitureCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="Catalogue de la Forge — Atlas" MinWidth="980" MinHeight="620" Width="1280" Height="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_OnPreviewKeyDown" Closing="Window_OnClosing">
    <Window.Resources>
        <Style x:Key="CatalogViewMode" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeShell" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="11,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeShell" Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeShell" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter TargetName="ModeShell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Background="#24282B" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="4" Background="#30383D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <TextBlock Text="▤" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CATALOGUE DE LA FORGE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Choisir un meuble sans quitter la fiche en cours" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click"/>
                        <Button Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" MinWidth="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*" MinWidth="165"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*" MinWidth="165"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*" MinWidth="175"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="38,9,12,9" ToolTip="Nom, référence, famille, type, univers ou usage"/>
                        <TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" ToolTip="Filtrer par statut"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" ToolTip="Filtrer par type"/>
                    <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" ToolTip="Trier les résultats"/>
                    <Button Grid.Column="7" Content="Effacer" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ClearFilters_OnClick"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="340" MinWidth="300" MaxWidth="390"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <TextBlock Text="{Binding ResultLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <CheckBox Content="Fiches à compléter" IsChecked="{Binding IncompleteOnly}" Margin="0,0,14,0"/>
                                    <RadioButton Content="Liste" GroupName="CatalogView" Style="{StaticResource CatalogViewMode}" IsChecked="{Binding IsCardView, Converter={StaticResource InverseBool}}" Click="ViewMode_OnClick"/>
                                    <RadioButton Content="Cartes" GroupName="CatalogView" Style="{StaticResource CatalogViewMode}" IsChecked="{Binding IsCardView}" Margin="-1,0,0,0" Click="ViewMode_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="FurnitureGrid" Grid.Row="1" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}"
                                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                  Visibility="{Binding IsCardView, Converter={StaticResource InverseBoolVisibility}}"
                                  MouseDoubleClick="FurnitureItems_OnMouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom du meuble" Binding="{Binding DisplayName}" Width="*" MinWidth="190"/>
                                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="112"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeMeuble}" Width="145"/>
                                <DataGridTemplateColumn Header="Statut" Width="108">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}" Style="{StaticResource Caption}"/></Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Modifiée" Binding="{Binding ModifiedUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox x:Name="FurnitureCards" Grid.Row="1" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}"
                                 Visibility="{Binding IsCardView, Converter={StaticResource BoolVisibility}}"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 Padding="12" MouseDoubleClick="FurnitureItems_OnMouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><controls:VirtualizingWrapPanel TargetItemWidth="235" ItemHeight="276" Spacing="12"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" CornerRadius="6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{StaticResource SelectionHoverBrush}"/><Setter Property="BorderBrush" Value="#667279"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{StaticResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="168"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Background="{StaticResource PreviewBrush}" CornerRadius="5" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="Aperçu indisponible" Foreground="#6A7479" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Stretch="Uniform" Margin="5" Loaded="CardImage_OnLoaded" Unloaded="CardImage_OnUnloaded"/>
                                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"><TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}" Style="{StaticResource Caption}"/></Border>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1" Margin="1,9,1,0">
                                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Reference}" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="2" Text="{Binding TypeMeuble}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="APERÇU" Style="{StaticResource Eyebrow}"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource Pill}" Visibility="{Binding IsSelectedFurnitureOpen, Converter={StaticResource BoolVisibility}}"><TextBlock Text="OUVERT DANS LA FORGE" Foreground="{StaticResource CyanBrush}" FontSize="9" FontWeight="Bold"/></Border>
                                </Grid>
                                <TextBlock Text="{Binding SelectedFurniture.DisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedFurniture.Reference}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <Border Height="230" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <TextBlock Text="Aucun aperçu disponible" Foreground="#6A7479" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8"/>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="TYPE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedFurniture.TypeMeuble}" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="STATUT" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SelectedFurniture.Status, Converter={StaticResource StatusLabel}}" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel>
                                </Grid>
                                <Separator Margin="0,13"/>
                                <TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding SelectedUniverses}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="USAGES" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/>
                                <TextBlock Text="{Binding SelectedUsages}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="COMPOSITION" Style="{StaticResource Eyebrow}" Margin="0,13,0,0"/>
                                <TextBlock Text="{Binding SelectedCompositionLabel}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SelectedFurniture.Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,13,0,0" MaxHeight="92"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="14">
                            <Button Content="Ouvrir dans la Forge" IsEnabled="{Binding HasSelection}" Click="OpenSelected_OnClick" HorizontalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#24282B" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <TextBlock Text="Double-cliquez sur une ligne ou appuyez sur Entrée pour l’ouvrir." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ctrl+K : rechercher · Échap : fermer" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
