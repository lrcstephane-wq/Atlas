<UserControl x:Class="Atlas.App.Views.FurnitureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <StackPanel><TextBlock Text="FORGE / MEUBLES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Composer sans perdre le fil" Style="{StaticResource PageTitle}"/><TextBlock Text="Deux chemins : créer directement une fiche ou structurer d’abord une famille et ses variantes." Style="{StaticResource Caption}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Border Background="#0D1725" CornerRadius="9" Padding="4" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Button Content="Fiche directe" Style="{StaticResource GhostButton}" Command="{Binding SetCreationModeCommand}" CommandParameter="Quick" Padding="12,7"/><Button Content="Famille + variantes" Style="{StaticResource GhostButton}" Command="{Binding SetCreationModeCommand}" CommandParameter="Family" Padding="12,7" Margin="4,0,0,0"/></StackPanel></Border><Button Content="Nouveau meuble" Command="{Binding CreateFurnitureCommand}"/></StackPanel>
  </Grid>

  <Grid Grid.Row="1" Visibility="{Binding IsFamilyMode, Converter={StaticResource BoolVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="7,7,7,12"><TextBlock Text="FAMILLES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Socles communs" Style="{StaticResource SectionTitle}" Margin="0,4,0,0"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding FurnitureFamilies}" SelectedItem="{Binding SelectedFurnitureFamily}"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,7"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeMeuble}" Style="{StaticResource Caption}" Margin="0,3,0,0"/><TextBlock Text="{Binding Id}" Foreground="{StaticResource CyanBrush}" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Nouvelle famille" Style="{StaticResource GhostButton}" Command="{Binding CreateFamilyCommand}"/></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource HeroGradient}" CornerRadius="13,13,0,0" Padding="20"><Grid><StackPanel><TextBlock Text="DONNÉES COMMUNES" Style="{StaticResource Eyebrow}" Foreground="#B7FFF5"/><TextBlock Text="{Binding SelectedFurnitureFamily.Name}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Pill}"><TextBlock Text="Héritées par les variantes" Style="{StaticResource Caption}"/></Border></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="24" IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nom de la famille" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurnitureFamily.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Description commune" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox Text="{Binding SelectedFurnitureFamily.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100"/><TextBlock Text="Univers hérités" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox Text="{Binding SelectedFurnitureFamily.UniversesCsv, UpdateSourceTrigger=LostFocus}" ToolTip="Séparer les univers par des virgules"/><TextBlock Text="Ex. Cuisine, Buanderie. La variante pourra ensuite être contrôlée avant publication." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Type de meuble" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FurnitureTypes}" SelectedItem="{Binding SelectedFurnitureFamily.TypeMeuble}"/><TextBlock Text="Usage spécifique" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding FurnitureUsages}" SelectedItem="{Binding SelectedFurnitureFamily.UsageSpecifique}"/><TextBlock Text="Forme" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding FurnitureForms}" SelectedItem="{Binding SelectedFurnitureFamily.Forme}"/><Border Background="#10233A" BorderBrush="#244D79" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,18,0,0"><StackPanel><TextBlock Text="Principe d’héritage" FontWeight="SemiBold"/><TextBlock Text="La famille porte le commun. Chaque meuble reste un fichier .TOP distinct et ne stocke que ses différences." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></Grid></ScrollViewer><Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><TextBlock Text="Créez une variante à partir de cette famille pour ouvrir sa fiche complète." Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="Créer une variante" HorizontalAlignment="Right" Command="{Binding CreateFurnitureCommand}"/></Grid></Border></Grid></Border>
  </Grid>

  <Grid Grid.Row="1" Visibility="{Binding IsFamilyMode, Converter={StaticResource InverseBoolVisibility}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="7,7,7,12"><TextBlock Text="FICHES MEUBLES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding FurnitureCount, StringFormat='{}{0} fiche(s) réelle(s)'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Row="1" Text="{Binding FurnitureSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Référence, nom, famille ou type" Margin="0,0,0,10"/><ListBox Grid.Row="2" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Row="1" Text="{Binding Reference}" Foreground="{StaticResource CyanBrush}" FontSize="10" Margin="0,4,0,0"/><Grid Grid.Row="2" Margin="0,7,0,0"><TextBlock Text="{Binding TypeMeuble}" Style="{StaticResource Caption}"/><Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="7,2"><TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}" FontSize="9"/></Border></Grid></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource HeroGradient}" CornerRadius="13,13,0,0" Padding="20"><Grid><StackPanel><TextBlock Text="FICHE MEUBLE" Style="{StaticResource Eyebrow}" Foreground="#B7FFF5"/><TextBlock Text="{Binding SelectedFurniture.DisplayName}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedFurniture.Reference}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding SelectedFurniture.Status, Converter={StaticResource StatusLabel}}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#0D1725"><StackPanel Orientation="Horizontal" Margin="14,10"><Button Content="01  Identité" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Identity"/><Button Content="02  Classement" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Classification"/><Button Content="03  Structure" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Structure"/><Button Content="04  Composition" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Composition"/><Button Content="05  Équipements" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Equipment"/><Button Content="06  Assemblage" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Assembly"/><Button Content="07  Capacités" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Capabilities"/><Button Content="08  Famille" Style="{StaticResource StepButton}" Command="{Binding NavigateFurnitureStepCommand}" CommandParameter="Family"/></StackPanel></ScrollViewer>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><Grid Margin="22" IsEnabled="{Binding CanEdit}">
      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Identity}"><TextBlock Text="01 / IDENTITÉ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Le meuble et son fichier" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Identifiant unique" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.Id}" IsReadOnly="True"/><TextBlock Text="Référence interne" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedFurniture.Reference, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nom affiché au client" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedFurniture.DisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Chemin relatif du .TOP" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.SourceRelativePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Image principale (.png)" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedFurniture.ImageRelativePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedFurniture.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76"/></StackPanel></Grid></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Classification}"><TextBlock Text="02 / CLASSEMENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Où et comment le retrouver" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><TextBlock Text="Univers — plusieurs choix possibles" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding UniverseOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource ChipCheck}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Margin="0,7,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewUniverseName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom du nouvel univers"/><Button Grid.Column="1" Content="Ajouter au référentiel" Command="{Binding AddUniverseCommand}" Margin="8,0,0,0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FurnitureTypes}" SelectedItem="{Binding SelectedFurniture.TypeMeuble}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Usage spécifique" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FurnitureUsages}" SelectedItem="{Binding SelectedFurniture.UsageSpecifique}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Forme" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FurnitureForms}" SelectedItem="{Binding SelectedFurniture.Forme}"/></StackPanel></Grid></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Structure}"><TextBlock Text="03 / STRUCTURE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Principe constructif" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Principe de construction" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ConstructionPrinciples}" SelectedItem="{Binding SelectedFurniture.PrincipleConstruction}"/><TextBlock Text="Correspondance technique" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/><TextBox Text="{Binding SelectedFurniture.SensMontage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Paramètre TopSolid Sens_Montage"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Position du dos" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding BackPositions}" SelectedItem="{Binding SelectedFurniture.PositionDos}"/><CheckBox Content="Séparation horizontale" IsChecked="{Binding SelectedFurniture.SeparationHorizontale}" Margin="0,18,0,10"/><CheckBox Content="Séparation verticale" IsChecked="{Binding SelectedFurniture.SeparationVerticale}"/></StackPanel></Grid></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Composition}"><TextBlock Text="04 / COMPOSITION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Éléments et composants déclarés" Style="{StaticResource SectionTitle}" Margin="0,5,0,16"/><UniformGrid Columns="3"><CheckBox Content="Portes" IsChecked="{Binding SelectedFurniture.Porte}" Margin="0,7"/><CheckBox Content="Tiroirs" IsChecked="{Binding SelectedFurniture.Tiroir}" Margin="0,7"/><CheckBox Content="Tiroirs à l’anglaise" IsChecked="{Binding SelectedFurniture.TiroirAnglaise}" Margin="0,7"/><CheckBox Content="Abattants" IsChecked="{Binding SelectedFurniture.Abattant}" Margin="0,7"/><CheckBox Content="Relevants" IsChecked="{Binding SelectedFurniture.Relevant}" Margin="0,7"/><CheckBox Content="Rayons" IsChecked="{Binding SelectedFurniture.Rayon}" Margin="0,7"/><CheckBox Content="Penderie" IsChecked="{Binding SelectedFurniture.Penderie}" Margin="0,7"/><CheckBox Content="Niches ouvertes" IsChecked="{Binding SelectedFurniture.NicheOuverte}" Margin="0,7"/></UniformGrid><Grid Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Typologie porte" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DoorTypes}" SelectedItem="{Binding SelectedFurniture.TypologiePorte}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Typologie tiroir" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DrawerTypes}" SelectedItem="{Binding SelectedFurniture.TypologieTiroir}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Abattant / relevant" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedFurniture.TypologieAbattant}" ToolTip="Typologie abattant"/><TextBox Grid.Column="2" Text="{Binding SelectedFurniture.TypologieRelevant}" ToolTip="Typologie relevant"/></Grid></StackPanel></Grid><UniformGrid Columns="4" Margin="0,0,0,14"><StackPanel Margin="0,0,8,0"><TextBlock Text="Nb portes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.NombrePortes}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Nb tiroirs" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.NombreTiroirs}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Nb rayons" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.NombreRayons}"/></StackPanel><StackPanel><TextBlock Text="Nb niches" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedFurniture.NombreNichesOuvertes}"/></StackPanel></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding LinkedComponents}" SelectedItem="{Binding SelectedLinkedComponent}" AutoGenerateColumns="False" IsReadOnly="True" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Composition déclarée" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Fonction" Binding="{Binding Function}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="2"><Button Content="Ajouter les composants cochés dans Forge" Command="{Binding AddMarkedComponentsCommand}" Margin="0,0,0,8"/><Button Content="Retirer le composant sélectionné" Style="{StaticResource GhostButton}" Command="{Binding RemoveComponentCommand}"/><TextBlock Text="Ou ajouter un composant ponctuel :" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedCompositionCandidate}" DisplayMemberPath="DisplayName"/><Button Content="Ajouter" Style="{StaticResource GhostButton}" Command="{Binding AddComponentCommand}" Margin="0,7,0,0"/></StackPanel></Grid></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Equipment}"><TextBlock Text="05 / ÉQUIPEMENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Équipement hérité des composants" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><Border Background="#10233A" BorderBrush="#244D79" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Atlas ne redemande pas l’information" FontWeight="SemiBold"/><TextBlock Text="Charnières, coulisses, relevants, abattants, coulissants, penderie, électricité et éclairage proviennent des fiches composants présentes dans la composition." Style="{StaticResource Caption}" Margin="0,6,0,13"/><TextBlock Text="{Binding InheritedCompatibility, StringFormat='Compatibilités détectées : {0}'}" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border><DataGrid ItemsSource="{Binding LinkedComponents}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Composant source" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Fonction / équipement" Binding="{Binding Function}" Width="*"/><DataGridTextColumn Header="Compatibilités" Binding="{Binding CompatibilityCsv}" Width="1.2*"/></DataGrid.Columns></DataGrid></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Assembly}"><TextBlock Text="06 / ASSEMBLAGE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Mode d’assemblage" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><TextBlock Text="Type contrôlé" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AssemblyTypes}" SelectedItem="{Binding SelectedFurniture.TypeAssemblage}" Width="430" HorizontalAlignment="Left"/><Border Background="#171F2B" BorderBrush="#4C3B27" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,18,0,0"><TextBlock Text="Cette valeur décrit le meuble fini. Elle reste indépendante du format SC ou EP du catalogue : un espace Atlas n’utilise jamais les deux à la fois." Foreground="{StaticResource AmberBrush}"/></Border></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Capabilities}"><TextBlock Text="07 / CAPACITÉS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Ce que le meuble sait proposer" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><Border Background="#102D2D" BorderBrush="#24645C" BorderThickness="1" CornerRadius="10" Padding="17"><StackPanel><TextBlock Text="Capacités calculées" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="{Binding InheritedCapabilities}" FontSize="15" Margin="0,8,0,0"/><TextBlock Text="Ces capacités sont agrégées depuis les composants déclarés. Une future étape permettra de désactiver une capacité héritée dans un contexte meuble exceptionnel." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border><Border Background="#111C2B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,14,0,0"><StackPanel><TextBlock Text="Compatibilités calculées" FontWeight="SemiBold"/><TextBlock Text="{Binding InheritedCompatibility}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>

      <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Family}"><TextBlock Text="08 / FAMILLE &amp; VARIANTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Lien de parenté" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/><TextBlock Text="Famille associée" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FurnitureFamilies}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedFurniture.FamilyId}" Width="430" HorizontalAlignment="Left"/><TextBlock Text="Nom de famille repris dans la fiche" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox Text="{Binding SelectedFurniture.Family, UpdateSourceTrigger=PropertyChanged}" Width="430" HorizontalAlignment="Left"/><Border Background="#10233A" BorderBrush="#244D79" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock Text="Règle Atlas" FontWeight="SemiBold"/><TextBlock Text="La famille contient le commun ; cette fiche porte uniquement les différences de la variante. En cas de conflit, la validation forcée reste humaine, motivée et tracée." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="Motif de validation forcée" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/><TextBox Text="{Binding SelectedFurniture.ForcedValidationReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64"/></StackPanel>
     </Grid></ScrollViewer>
     <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="15"><Grid><TextBlock Text="La publication reste toujours une décision humaine." Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="Valider &amp; publier dans le Catalogue" Command="{Binding PublishFurnitureCommand}" IsEnabled="{Binding CanValidate}" HorizontalAlignment="Right"/></Grid></Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
