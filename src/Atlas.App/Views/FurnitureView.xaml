<UserControl x:Class="Atlas.App.Views.FurnitureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Atlas.App.Controls">
 <Grid Margin="22">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="14"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
  <Grid>
<StackPanel>
<TextBlock Text="FORGE / MEUBLES" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Composer sans perdre le fil" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/>
<TextBlock Text="La composition réelle pilote automatiquement les familles et les tags du meuble." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
<Button Content="Fiche directe" Style="{StaticResource GhostButton}" Command="{Binding SetCreationModeCommand}" CommandParameter="Quick"/>
<Button Content="Famille + variantes" Style="{StaticResource GhostButton}" Command="{Binding SetCreationModeCommand}" CommandParameter="Family" Margin="7,0,0,0"/>
<Button Content="Nouveau meuble" Command="{Binding CreateFurnitureCommand}" Margin="10,0,0,0"/>
</StackPanel>
</Grid>
  <Grid Grid.Row="2">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="280"/>
<ColumnDefinition Width="12"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<StackPanel>
<TextBlock Text="FICHES MEUBLES" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="{Binding VisibleFurnitureCount, StringFormat={}{0} fiche(s) affichée(s)}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
</StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="Rechercher" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FurnitureSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom, référence, type ou description"/><ComboBox ItemsSource="{Binding FurnitureStatusOptions}" SelectedItem="{Binding SelectedFurnitureStatus}" Margin="0,7,0,0"/></StackPanel>
<ListBox Grid.Row="2" ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
<ListBox.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource RaisedCard}" Padding="13" Margin="0,0,0,8">
<Grid>
<StackPanel>
<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Reference}" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="0,5,0,0"/>
</StackPanel>
<Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
<TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}" Style="{StaticResource Caption}"/>
</Border>
</Grid>
</Border>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Grid>
</Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="74"/>
<RowDefinition Height="74"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
    <Border Background="{StaticResource HeroGradient}" CornerRadius="13,13,0,0" Padding="20,13">
<Grid>
<StackPanel>
<TextBlock Text="FICHE MEUBLE" Style="{StaticResource Eyebrow}" Foreground="White"/>
<TextBlock Text="{Binding SelectedFurniture.DisplayName}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
</StackPanel>
<StackPanel HorizontalAlignment="Right">
<TextBlock Text="{Binding SelectedFurniture.Reference}" FontWeight="Bold" HorizontalAlignment="Right"/>
<TextBlock Text="{Binding SelectedFurniture.Status, Converter={StaticResource StatusLabel}}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
</StackPanel>
</Grid>
</Border>
    <Border Grid.Row="1" Background="#0D1827" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<TextBlock Text="{Binding FurnitureStepIndicator}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
<ItemsControl Grid.Row="1" ItemsSource="{Binding FurnitureSteps}" Margin="0,7,0,0">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<StackPanel Orientation="Horizontal"/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Button Command="{Binding DataContext.NavigateFurnitureStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" Foreground="{Binding Foreground}" Padding="14,8" Margin="0,0,8,0">
<StackPanel Orientation="Horizontal">
<TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{Binding Foreground}"/>
<TextBlock Text="{Binding Label}" Margin="7,0,0,0" Foreground="{Binding Foreground}"/>
</StackPanel>
</Button>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Grid>
</Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
<Grid Margin="20">
     <Grid Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Identity}">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="1.25*"/>
<ColumnDefinition Width="22"/>
<ColumnDefinition Width="0.75*"/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="01 / IDENTITÉ" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Le meuble et son fichier" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/>
<TextBlock Text="Référence interne" Style="{StaticResource FieldLabel}"/>
<TextBox Text="{Binding SelectedFurniture.Reference, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Nom affiché au client" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/>
<TextBox Text="{Binding SelectedFurniture.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Date de conception" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/>
<DatePicker SelectedDate="{Binding SelectedFurniture.ConceptionDate}" SelectedDateFormat="Long" Foreground="White" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource CobaltBrush}"/>
<TextBlock Text="Description libre" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/>
<TextBox Text="{Binding SelectedFurniture.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalContentAlignment="Top"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock Text="APERÇU ASSOCIÉ" Style="{StaticResource Eyebrow}"/>
<Border Background="#09121F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Height="300" Margin="0,9,0,14">
<Grid>
<TextBlock Text="Aucun aperçu .top.png" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Image Source="{Binding FurniturePreview}" Stretch="Uniform" Margin="10"/>
</Grid>
</Border>
<TextBlock Text="Fichier .TOP" Style="{StaticResource FieldLabel}"/>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox Text="{Binding SelectedFurniture.SourceRelativePath}" IsReadOnly="True"/>
<Button Grid.Column="1" Content="Choisir…" Command="{Binding ChooseFurnitureTopCommand}" Margin="7,0,0,0"/>
<Button Grid.Column="2" Content="Ouvrir le dossier" Style="{StaticResource GhostButton}" Command="{Binding OpenFurnitureFolderCommand}" Margin="7,0,0,0"/>
</Grid>
<TextBlock Text="Atlas ne lit jamais le contenu du .TOP. Il utilise uniquement son emplacement et son image associée." Style="{StaticResource Caption}" Margin="0,9,0,0"/>
</StackPanel>
</Grid>
     <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Classification}">
<TextBlock Text="02 / CLASSEMENT" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Où et comment le retrouver" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/>
<TextBlock Text="Univers — plusieurs choix possibles" Style="{StaticResource FieldLabel}"/>
<ItemsControl ItemsSource="{Binding UniverseOptions}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<WrapPanel/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource ChipCheck}"/>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<Grid Margin="0,14,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="16"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="Type de meuble — un seul choix" Style="{StaticResource FieldLabel}"/>
<ComboBox ItemsSource="{Binding FurnitureTypes}" SelectedItem="{Binding SelectedFurniture.TypeMeuble}"/>
<TextBlock Text="Forme — un seul choix" Style="{StaticResource FieldLabel}" Margin="0,13,0,5"/>
<ComboBox ItemsSource="{Binding FurnitureForms}" SelectedItem="{Binding SelectedFurniture.Forme}"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock Text="Usages spécifiques — choix cumulables" Style="{StaticResource FieldLabel}"/>
<Border Style="{StaticResource RaisedCard}" Padding="12">
<ItemsControl ItemsSource="{Binding UsageOptions}">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<WrapPanel/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource ChipCheck}"/>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Border>
</StackPanel>
</Grid>
<TextBlock Text="Tags du meuble — hérités des composants et ajustables ici" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
<Border Style="{StaticResource RaisedCard}" Padding="12"><ItemsControl ItemsSource="{Binding FurnitureTagOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource ChipCheck}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
</StackPanel>
     <Grid Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Composition}">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="1.45*"/>
<ColumnDefinition Width="18"/>
<ColumnDefinition Width="0.75*"/>
</Grid.ColumnDefinitions>
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<StackPanel>
<TextBlock Text="03 / COMPOSITION" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Sélectionner les vrais composants" Style="{StaticResource SectionTitle}" Margin="0,5,0,13"/>
</StackPanel>
<Grid Grid.Row="1">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="220"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="210"/>
</Grid.ColumnDefinitions>
<ComboBox ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding SelectedLibraryFilter}" DisplayMemberPath="Name"/>
<TextBox Grid.Column="1" Text="{Binding ComponentSearch, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
<ComboBox Grid.Column="2" ItemsSource="{Binding ComponentTypeOptions}" SelectedItem="{Binding SelectedComponentType}"/>
</Grid>
<ItemsControl Grid.Row="2" ItemsSource="{Binding FamilyFilters}" Margin="0,9,0,7">
<ItemsControl.ItemsPanel>
<ItemsPanelTemplate>
<WrapPanel/>
</ItemsPanelTemplate>
</ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Button Content="{Binding Label}" Command="{Binding DataContext.SetFamilyFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Label}" Background="{Binding Background}" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,6,6"/>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<ListBox Grid.Row="3" ItemsSource="{Binding ComponentView}" SelectedItem="{Binding SelectedComponentCard}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
<ListBox.ItemsPanel>
<ItemsPanelTemplate>
<controls:VirtualizingWrapPanel ItemWidth="205" ItemHeight="196"/>
</ItemsPanelTemplate>
</ListBox.ItemsPanel>
<ListBox.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource RaisedCard}" Width="194" Height="185" Margin="0,0,8,8" Padding="9">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="104"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<Border Background="#08111D" CornerRadius="8">
<Grid>
<TextBlock Text="Aperçu" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="5"/>
<CheckBox IsChecked="{Binding IsMarked}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"/>
</Grid>
</Border>
<StackPanel Grid.Row="1" Margin="0,7,0,0">
<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
<TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/>
</StackPanel>
</Grid>
</Border>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Grid>
<StackPanel Grid.Column="2">
<TextBlock Text="COMPOSITION RETENUE" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="{Binding MarkedComponentCount, StringFormat={}{0} composant(s) coché(s)}" Style="{StaticResource Caption}" Margin="0,5,0,9"/>
<Button Content="Ajouter les composants cochés" Command="{Binding AddMarkedComponentsCommand}"/>
<TextBlock Text="{Binding CompositionTotalQuantity, StringFormat={}{0} élément(s) au total}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
<DataGrid x:Name="CompositionGrid" ItemsSource="{Binding CompositionLines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="320" Margin="0,10,0,8" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="CompositionGrid_OnSelectionChanged">
<DataGrid.Columns>
<DataGridTemplateColumn Header="Composant" Width="*">
<DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#09121F" CornerRadius="6"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Qté" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
</DataGrid.Columns>
</DataGrid>
<Button Content="{Binding RemoveCompositionLabel}" Style="{StaticResource GhostButton}" Command="{Binding RemoveMarkedCompositionCommand}"/>
<Border Background="#102D2D" BorderBrush="#24645C" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
<StackPanel>
<TextBlock Text="Informations héritées" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"/>
<TextBlock Text="Familles détectées" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
<TextBlock Text="{Binding InheritedFamilies}"/>
<TextBlock Text="Tags classés" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
<TextBlock Text="{Binding InheritedTagsByCategory}"/>
<TextBlock Text="{Binding CharacteristicWarnings}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel>
</Border>
</StackPanel>
</Grid>
     <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Structure}">
<TextBlock Text="04 / STRUCTURE" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Caractéristiques propres au meuble fini" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="18"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="Principe de construction" Style="{StaticResource FieldLabel}"/>
<ComboBox ItemsSource="{Binding ConstructionPrinciples}" SelectedItem="{Binding SelectedFurniture.PrincipleConstruction}"/>
<TextBlock Text="Position du dos" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
<ComboBox ItemsSource="{Binding BackPositions}" SelectedItem="{Binding SelectedFurniture.PositionDos}"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock Text="Mode d’assemblage" Style="{StaticResource FieldLabel}"/>
<ComboBox ItemsSource="{Binding AssemblyTypes}" SelectedItem="{Binding SelectedFurniture.TypeAssemblage}"/>
<Border Background="#171F2B" BorderBrush="#4C3B27" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,14,0,0">
<TextBlock Text="Ces choix décrivent le meuble fini. Les caractéristiques de quincaillerie, façades, pieds ou coulissants viennent des composants et de leurs tags." Foreground="{StaticResource AmberBrush}"/>
</Border>
</StackPanel>
</Grid>
</StackPanel>
     <StackPanel Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Review}">
<TextBlock Text="05 / CONTRÔLE" Style="{StaticResource Eyebrow}"/>
<TextBlock Text="Vérifier avant publication" Style="{StaticResource SectionTitle}" Margin="0,5,0,18"/>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="16"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource RaisedCard}">
<StackPanel>
<TextBlock Text="Classement" FontWeight="SemiBold"/>
<TextBlock Text="{Binding SelectedFurniture.UniversesCsv, StringFormat='Univers : {0}'}" Margin="0,8,0,0"/>
<TextBlock Text="{Binding SelectedFurniture.UsageSpecifique, StringFormat='Usages : {0}'}"/>
<TextBlock Text="{Binding SelectedFurniture.TypeMeuble, StringFormat='Type : {0}'}"/>
<TextBlock Text="{Binding SelectedFurniture.Forme, StringFormat='Forme : {0}'}"/>
</StackPanel>
</Border>
<Border Grid.Column="2" Style="{StaticResource RaisedCard}">
<StackPanel>
<TextBlock Text="Composition héritée" FontWeight="SemiBold"/>
<TextBlock Text="{Binding LinkedComponents.Count, StringFormat='Composants : {0}'}" Margin="0,8,0,0"/>
<TextBlock Text="{Binding InheritedFamilies, StringFormat='Familles : {0}'}"/>
<TextBlock Text="{Binding InheritedTagsByCategory}" Margin="0,6,0,0"/>
</StackPanel>
</Border>
</Grid>
<Border Style="{StaticResource RaisedCard}" Margin="0,16,0,0">
<StackPanel>
<TextBlock Text="Structure" FontWeight="SemiBold"/>
<TextBlock Text="{Binding SelectedFurniture.PrincipleConstruction, StringFormat='Construction : {0}'}" Margin="0,8,0,0"/>
<TextBlock Text="{Binding SelectedFurniture.PositionDos, StringFormat='Dos : {0}'}"/>
<TextBlock Text="{Binding SelectedFurniture.TypeAssemblage, StringFormat='Assemblage : {0}'}"/>
</StackPanel>
</Border>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#09121F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Height="180"><Image Source="{Binding FurniturePreview}" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="2"><TextBlock Text="Fichier .TOP" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedFurniture.SourceRelativePath}" TextWrapping="Wrap"/><Button Content="Ouvrir le dossier" Style="{StaticResource GhostButton}" Command="{Binding OpenFurnitureFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="{Binding CharacteristicWarnings}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Grid>
<Border Background="#102D2D" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,16,0,0"><CheckBox IsChecked="{Binding SelectedFurniture.IsPublicationReviewed}"><TextBlock Text="J’ai contrôlé l’identité, le classement, la composition et la structure de ce meuble." TextWrapping="Wrap" FontWeight="SemiBold"/></CheckBox></Border>
</StackPanel>
    </Grid>
</ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
<Grid>
<TextBlock Text="La publication reste toujours une décision humaine." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="Précédent" Style="{StaticResource GhostButton}" Command="{Binding PreviousFurnitureStepCommand}"/>
<Button Content="Enregistrer le brouillon" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
<Button Content="Suivant" Command="{Binding NextFurnitureStepCommand}" Margin="8,0,0,0"/>
<Button Content="Valider &amp; publier" Command="{Binding PublishFurnitureCommand}" IsEnabled="{Binding CanValidate}" Margin="8,0,0,0" Visibility="{Binding CurrentFurnitureStep, Converter={StaticResource PageVisibility}, ConverterParameter=Review}"/>
</StackPanel>
</Grid>
</Border>
   </Grid>
</Border>
  </Grid>
 </Grid>
</UserControl>
