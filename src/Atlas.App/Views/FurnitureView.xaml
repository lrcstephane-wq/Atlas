<UserControl x:Class="Atlas.App.Views.FurnitureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Forge · Meubles et composition" Style="{StaticResource PageTitle}"/><TextBlock Text="Déclarez les composants utilisés ; Atlas calcule ce que le meuble peut proposer." Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,18"/></StackPanel><Button Content="Nouveau meuble" Command="{Binding CreateFurnitureCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
        <TextBox Grid.Row="1" Text="{Binding FurnitureSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher un meuble" Height="39" Margin="0,0,0,14"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding FurnitureView}" SelectedItem="{Binding SelectedFurniture}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="100"/><DataGridTextColumn Header="Meuble" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="État" Binding="{Binding Status, Converter={StaticResource StatusLabel}}" Width="95"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Text="Fiche meuble" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Référence" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedFurniture.Reference, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Nom" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedFurniture.DisplayName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Famille" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedFurniture.Family, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,4"/><TextBox Text="{Binding SelectedFurniture.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="58"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Principe de construction" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedFurniture.PrincipleConstruction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Sens_Montage TopSolid" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedFurniture.SensMontage, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel></Grid>
                <TextBlock Text="Composition déclarée" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding LinkedComponents}" SelectedItem="{Binding SelectedLinkedComponent}" AutoGenerateColumns="False" IsReadOnly="True" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Composant" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Fonction" Binding="{Binding Function}" Width="120"/></DataGrid.Columns></DataGrid><Button Grid.Column="1" Content="Retirer" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveComponentCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/></Grid>
                <TextBlock Text="Ajouter depuis les fiches composants" Style="{StaticResource Caption}" Margin="0,10,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding ComponentView}" SelectedItem="{Binding SelectedCompositionCandidate}" AutoGenerateColumns="False" IsReadOnly="True" Height="145"><DataGrid.Columns><DataGridTextColumn Header="Composant" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="État" Binding="{Binding Status, Converter={StaticResource StatusLabel}}" Width="95"/></DataGrid.Columns></DataGrid><Button Grid.Column="1" Content="Ajouter" Command="{Binding AddComponentCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/></Grid>
                <Border Background="#EDF4FF" CornerRadius="8" Padding="12" Margin="0,12,0,10"><StackPanel><TextBlock Text="Informations héritées" FontWeight="SemiBold" Foreground="{StaticResource BlueDarkBrush}"/><TextBlock Text="{Binding InheritedCapabilities, StringFormat='Capacités : {0}'}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding InheritedCompatibility, StringFormat='Compatibilités : {0}'}" Style="{StaticResource Caption}"/></StackPanel></Border>
                <TextBlock Text="Motif de forçage si la composition comporte une alerte" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedFurniture.ForcedValidationReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                <Button Content="Valider et publier dans l’aperçu" Command="{Binding PublishFurnitureCommand}" IsEnabled="{Binding CanValidate}"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
