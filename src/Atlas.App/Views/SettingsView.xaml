<UserControl x:Class="Atlas.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Paramètres et comptes" Style="{StaticResource PageTitle}"/><TextBlock Text="Configuration partagée, identité du catalogue et accès utilisateurs." Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,20"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Espace de travail" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                <TextBlock Text="Environnement du catalogue" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Settings.Environment}" Margin="0,5,0,12" IsEnabled="{Binding IsAdministrator}"/>
                <TextBlock Text="Racine de la bibliothèque TopSolid" Style="{StaticResource Caption}"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.LibraryRoot, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLibraryCommand}" Margin="8,0,0,0"/></Grid>
                <CheckBox Content="Rechercher automatiquement les mises à jour au lancement" IsChecked="{Binding Settings.AutoUpdate}" Margin="0,4,0,18"/>
                <TextBlock Text="Dossier partagé Atlas" Style="{StaticResource Caption}"/><Grid Margin="0,5,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SharedRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdministrator}"/><Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseSharedRootCommand}" Margin="8,0,0,0"/></Grid>
                <StackPanel Orientation="Horizontal"><Button Content="Appliquer au prochain lancement" Command="{Binding SaveBootstrapCommand}"/><Button Content="Ouvrir le dossier" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSharedRootCommand}" Margin="8,0,0,0"/></StackPanel>
                <TextBlock Text="Sous-dossiers créés automatiquement : Configuration, Data, Backups, Logs, Images et Locks." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Utilisateurs" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Les droits sont partagés. Les mots de passe sont hachés et ne sont jamais enregistrés en clair." Style="{StaticResource Caption}" Margin="0,6,0,14"/>
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" Height="170"><DataGrid.Columns><DataGridTextColumn Header="Nom" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Identifiant" Binding="{Binding Login}" Width="*"/><DataGridTextColumn Header="Droits" Binding="{Binding Permissions}" Width="1.3*"/></DataGrid.Columns></DataGrid>
                <StackPanel Visibility="{Binding IsAdministrator, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Ajouter un utilisateur" FontWeight="SemiBold" Margin="0,16,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nom affiché" Style="{StaticResource Caption}"/><TextBox x:Name="NewDisplayName" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Identifiant" Style="{StaticResource Caption}"/><TextBox x:Name="NewLogin" Margin="0,4,0,0"/></StackPanel></Grid>
                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mot de passe temporaire" Style="{StaticResource Caption}"/><PasswordBox x:Name="NewPassword" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Profil" Style="{StaticResource Caption}"/><ComboBox x:Name="NewRole" ItemsSource="{Binding RoleProfiles}" SelectedIndex="2" Margin="0,4,0,0"/></StackPanel></Grid>
                    <TextBlock x:Name="UserError" Foreground="#B42318" Margin="0,8,0,0"/>
                    <Button Content="Créer le compte" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CreateUser_OnClick"/>
                </StackPanel>
            </StackPanel></Border>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
