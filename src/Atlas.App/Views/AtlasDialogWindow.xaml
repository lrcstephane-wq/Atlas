<Window x:Class="Atlas.App.Views.AtlasDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" MinHeight="230" MaxHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource RaisedBrush}" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,10,0"><TextBlock Text="BIBLIDÉO ATLAS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Click="Close_OnClick"/></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="ToneBadge" Width="42" Height="42" CornerRadius="12" Background="{StaticResource CobaltBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock x:Name="ToneIcon" Text="i" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20" Margin="0,8,0,0"/></StackPanel></Grid>
                <Border Grid.Row="1" Background="{StaticResource FieldBrush}" CornerRadius="9" Padding="12" Margin="54,15,0,0" Visibility="Collapsed" x:Name="DetailPanel"><TextBlock x:Name="DetailText" Style="{StaticResource Caption}"/></Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_OnClick" Visibility="Collapsed"/><Button x:Name="ConfirmButton" Content="Compris" Click="Confirm_OnClick"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
