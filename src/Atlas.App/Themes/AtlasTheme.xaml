    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}"/><SolidColorBrush x:Key="NavigationBrush" Color="{StaticResource Navigation}"/><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/><SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}"/><SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Raised}"/><SolidColorBrush x:Key="FieldBrush" Color="{StaticResource Field}"/><SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="CobaltBrush" Color="{StaticResource Cobalt}"/><SolidColorBrush x:Key="CobaltDarkBrush" Color="{StaticResource CobaltDark}"/><SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}"/><SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}"/><SolidColorBrush x:Key="RoseBrush" Color="{StaticResource Rose}"/><SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
