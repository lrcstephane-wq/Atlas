    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="11"/></Style>
