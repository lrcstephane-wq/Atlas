<Window x:Class="Atlas.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connexion — Biblidéo Atlas" Width="1060" Height="670" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Border Background="{StaticResource CanvasBrush}" BorderBrush="#345D78" BorderThickness="1" CornerRadius="18" Effect="{StaticResource PanelShadow}">
  <Grid ClipToBounds="True">
   <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource HeroGradient}" CornerRadius="17,0,0,17" MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Grid><Rectangle Fill="{StaticResource AtlasGridBrush}" Opacity=".55"/><Grid Margin="48,42"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Image Source="pack://application:,,,/Assets/IdeoLogo.png" Height="50" HorizontalAlignment="Left"/>
     <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Biblidéo Atlas" FontSize="38" FontWeight="SemiBold"/><TextBlock Text="Construire dans Forge.&#10;Explorer dans Horizon." Foreground="#BED0DF" FontSize="19" LineHeight="29" Margin="0,14,0,0"/>
      <Border Background="#A80B1C2A" BorderBrush="#3B607A" BorderThickness="1" CornerRadius="13" Padding="17" Margin="0,42,0,0"><StackPanel><TextBlock Text="ENVIRONNEMENT IDÉO" Style="{StaticResource Eyebrow}"/><TextBlock Text="Une base commune, pensée pour grandir module après module." Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" LineHeight="20"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Grid.Row="2"><Border Width="42" Height="4" CornerRadius="2" Background="{StaticResource PrimaryGradient}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="ATLAS · ESPACE DE TRAVAIL PARTAGÉ" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
    </Grid></Grid>
   </Border>

   <Grid Grid.Column="1" Margin="66,36,58,48">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button Content="×" Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right" Click="Close_OnClick"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" Margin="0,20,0,0">
     <TextBlock Text="ACCÈS SÉCURISÉ" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Text="Connexion" Style="{StaticResource PageTitle}" Margin="0,6,0,0"/><TextBlock x:Name="HelpText" Text="Accédez à l’espace partagé Atlas." Style="{StaticResource Caption}" FontSize="14" Margin="0,7,0,28"/>
     <TextBlock Text="Dossier partagé" Style="{StaticResource FieldLabel}"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SharedRootBox"/><Button Grid.Column="1" Content="Parcourir" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseRoot_OnClick"/></Grid>
     <TextBlock x:Name="DisplayNameLabel" Text="Nom affiché" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/><TextBox x:Name="DisplayNameBox" Margin="0,0,0,16" Visibility="Collapsed"/>
     <TextBlock Text="Identifiant" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoginBox" Margin="0,0,0,16"/>
     <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" KeyDown="PasswordBox_OnKeyDown"/>
     <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" Margin="0,0,0,12"/>
     <Button x:Name="SubmitButton" Content="Se connecter" Click="SubmitButton_OnClick" Height="46"/>
     <TextBlock Text="Vos données restent sur votre infrastructure Atlas." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
