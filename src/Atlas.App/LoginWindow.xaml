<Window x:Class="Atlas.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connexion — Biblidéo Atlas" Width="1020" Height="640" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Border Background="{StaticResource CanvasBrush}" BorderBrush="#344A68" BorderThickness="1" CornerRadius="16">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="405"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource HeroGradient}" CornerRadius="15,0,0,15" Padding="46" MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="pack://application:,,,/Assets/IdeoLogo.png" Height="48" HorizontalAlignment="Left"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Biblidéo Atlas" FontSize="37" FontWeight="SemiBold"/><TextBlock Text="Construire dans Forge.&#10;Explorer dans Atlas." Foreground="#C7D7ED" FontSize="18" LineHeight="28" Margin="0,14,0,0"/><Border Background="#26101A2A" BorderBrush="#426A9E" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,42,0,0"><StackPanel><TextBlock Text="ATELIER PREMIUM" Style="{StaticResource Eyebrow}" Foreground="#B7FFF5"/><TextBlock Text="Une base commune, pensée pour grandir module après module." Foreground="#D9E5F4" Margin="0,7,0,0"/></StackPanel></Border></StackPanel><TextBlock Grid.Row="2" Text="V0.2 · espace de travail partagé" Foreground="#ACC0DA"/></Grid>
   </Border>
   <Grid Grid.Column="1" Margin="64,42,54,46">
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="×" Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right" Click="Close_OnClick"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center" Margin="0,18,0,0"><TextBlock Text="ACCÈS SÉCURISÉ" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="TitleText" Text="Connexion" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/><TextBlock x:Name="HelpText" Text="Accédez à l’espace partagé Atlas." Style="{StaticResource Caption}" FontSize="14" Margin="0,8,0,28"/><TextBlock Text="Dossier partagé" Style="{StaticResource FieldLabel}"/><Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SharedRootBox"/><Button Grid.Column="1" Content="Parcourir" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseRoot_OnClick"/></Grid><TextBlock x:Name="DisplayNameLabel" Text="Nom affiché" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/><TextBox x:Name="DisplayNameBox" Margin="0,0,0,15" Visibility="Collapsed"/><TextBlock Text="Identifiant" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoginBox" Margin="0,0,0,15"/><TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" KeyDown="PasswordBox_OnKeyDown"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" Margin="0,0,0,12"/><Button x:Name="SubmitButton" Content="Se connecter" Click="SubmitButton_OnClick" Height="43"/></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
