<Window x:Class="Atlas.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Biblidéo Atlas" Width="980" Height="610" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="48">
            <StackPanel VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/IdeoMark.png" Width="138" HorizontalAlignment="Left" />
                <TextBlock Text="Biblidéo Atlas" Foreground="White" FontSize="34" FontWeight="SemiBold" Margin="0,34,0,10" />
                <TextBlock Text="Construire dans Forge. Explorer dans Atlas." Foreground="#ADBED6" FontSize="17" LineHeight="25" />
                <Border Background="#1D3150" CornerRadius="10" Padding="16" Margin="0,42,0,0">
                    <TextBlock Text="V0.1 · socle de travail partagé" Foreground="#DCE6F5" />
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="64,50">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Connexion" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HelpText" Text="Accédez à l’espace partagé Atlas." Style="{StaticResource Caption}" FontSize="14" Margin="0,8,0,30" />
                <TextBlock Text="Dossier partagé" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SharedRootBox"/><Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseRoot_OnClick"/></Grid>
                <TextBlock x:Name="DisplayNameLabel" Text="Nom affiché" Style="{StaticResource Caption}" Margin="0,0,0,5" Visibility="Collapsed" />
                <TextBox x:Name="DisplayNameBox" Margin="0,0,0,16" Visibility="Collapsed" />
                <TextBlock Text="Identifiant" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <TextBox x:Name="LoginBox" Margin="0,0,0,16" />
                <TextBlock Text="Mot de passe" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,24" KeyDown="PasswordBox_OnKeyDown" />
                <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,0,0,12" />
                <Button x:Name="SubmitButton" Content="Se connecter" Click="SubmitButton_OnClick" Height="42" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
