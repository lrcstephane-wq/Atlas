<Window x:Class="Atlas.App.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue — Biblidéo Atlas" Width="1180" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Effect="{StaticResource PanelShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="42,30,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="4" Background="#292E31" BorderBrush="#4B5358" BorderThickness="1"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Margin="8"/></Border>
                    <StackPanel Margin="14,3,0,0"><TextBlock Text="BIBLIDÉO ATLAS" FontWeight="Bold" FontSize="17"/><TextBlock Text="Choisissez votre espace de travail" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_OnClick"/>
            </Grid>
            <Grid Grid.Row="1" Margin="54,44,54,38">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Comment souhaitez-vous ouvrir Atlas ?" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Chaque mode présente uniquement les outils nécessaires." Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,30"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Height="230" Click="SiteManager_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="58" Height="58" CornerRadius="4" Background="#344850" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="G" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Row="1" Text="Gestionnaire" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                            <TextBlock Grid.Row="2" Text="Configuration du site, des chemins, des comptes, des licences reçues et des contenus Atlas." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Text="S'IDENTIFIER  →" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Height="230" Click="Creator_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24" Style="{StaticResource GhostButton}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="58" Height="58" CornerRadius="4" Background="#3A4145" BorderBrush="#68747A" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="C" FontSize="23" FontWeight="Bold" Foreground="#DDE2E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Row="1" Text="Créateur" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                            <TextBlock Grid.Row="2" Text="Compte client sécurisé pour ajouter ses propres meubles, Univers Client et Tags Client." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Text="S'IDENTIFIER  →" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="4" Height="230" Click="User_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24" Style="{StaticResource GhostButton}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="58" Height="58" CornerRadius="4" Background="#3A4145" BorderBrush="#68747A" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="H" FontSize="23" FontWeight="Bold" Foreground="#DDE2E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Row="1" Text="Utilisateur" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                            <TextBlock Grid.Row="2" Text="Accès direct à Horizon et aux meubles publiés, sans accès à la Forge ni aux paramètres administratifs." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Text="OUVRIR HORIZON  →" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#24282B" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="28,10" CornerRadius="0,0,7,7"><Grid><TextBlock Text="Vous pourrez vous identifier depuis Horizon sans redémarrer Atlas." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Content="Accès Administrateur Idéo" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="IdeoAdministrator_OnClick"/></Grid></Border>
        </Grid>
    </Border>
</Window>
