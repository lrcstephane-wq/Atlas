<Window x:Class="Atlas.App.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue — Biblidéo Atlas" Width="980" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CanvasBrush}" BorderBrush="#345D78" BorderThickness="1" CornerRadius="18" Effect="{StaticResource PanelShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="42,30,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#122C41" BorderBrush="#345875" BorderThickness="1"><Image Source="pack://application:,,,/Assets/IdeoMark.png" Margin="8"/></Border>
                    <StackPanel Margin="14,3,0,0"><TextBlock Text="BIBLIDÉO ATLAS" FontWeight="Bold" FontSize="17"/><TextBlock Text="Choisissez votre espace de travail" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_OnClick"/>
            </Grid>
            <Grid Grid.Row="1" Margin="74,44,74,38">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Comment souhaitez-vous ouvrir Atlas ?" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Chaque mode présente uniquement les outils nécessaires." Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,30"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Height="230" Click="Administrator_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="#163550" HorizontalAlignment="Left"><TextBlock Text="A" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Row="1" Text="Administrateur" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                            <TextBlock Grid.Row="2" Text="Identification sécurisée puis accès à la Forge, Horizon et aux paramètres selon vos droits." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Text="S'IDENTIFIER  →" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Height="230" Click="User_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24" Style="{StaticResource GhostButton}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="#183B35" BorderBrush="#2E7468" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="H" FontSize="23" FontWeight="Bold" Foreground="#7FE0D0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Grid.Row="1" Text="Utilisateur" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                            <TextBlock Grid.Row="2" Text="Accès direct à Horizon et aux meubles publiés, sans accès à la Forge ni aux paramètres administratifs." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Text="OUVRIR HORIZON  →" Foreground="#7FE0D0" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#A10A1824" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="28,14" CornerRadius="0,0,17,17"><TextBlock Text="Vous pourrez vous identifier depuis Horizon sans redémarrer Atlas." Style="{StaticResource Caption}" HorizontalAlignment="Center"/></Border>
        </Grid>
    </Border>
</Window>
