<Window x:Class="Atlas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Atlas.App.Views"
        Title="Biblidéo Atlas" MinWidth="1180" MinHeight="760" Width="1500" Height="920" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="125"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="22,22,18,12">
                    <Image Source="pack://application:,,,/Assets/IdeoLogo.png" Height="46" HorizontalAlignment="Left" />
                    <TextBlock Text="BIBLIDÉO ATLAS" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="2,16,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="VUE D’ENSEMBLE" Foreground="#7187A6" FontSize="10" FontWeight="Bold" Margin="22,10,0,6" />
                        <Button Style="{StaticResource NavButton}" Content="⌂  Vue d’ensemble" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                        <TextBlock Text="FORGE" Foreground="#7187A6" FontSize="10" FontWeight="Bold" Margin="22,22,0,6" />
                        <Button Style="{StaticResource NavButton}" Content="▦  Fiches composants" Command="{Binding NavigateCommand}" CommandParameter="Components" />
                        <Button Style="{StaticResource NavButton}" Content="▤  Meubles et composition" Command="{Binding NavigateCommand}" CommandParameter="Furniture" />
                        <Button Style="{StaticResource NavButton}" Content="◇  Familles et variantes" Command="{Binding NavigateCommand}" CommandParameter="Future" />
                        <Button Style="{StaticResource NavButton}" Content="⇄  Compatibilités" Command="{Binding NavigateCommand}" CommandParameter="Future" />
                        <Button Style="{StaticResource NavButton}" Content="✓  Validation et publication" Command="{Binding NavigateCommand}" CommandParameter="Future" />
                        <TextBlock Text="EXPÉRIENCE CLIENT" Foreground="#7187A6" FontSize="10" FontWeight="Bold" Margin="22,22,0,6" />
                        <Button Style="{StaticResource NavButton}" Content="▣  Aperçu Catalogue Atlas" Command="{Binding NavigateCommand}" CommandParameter="Catalog" />
                        <TextBlock Text="SYSTÈME" Foreground="#7187A6" FontSize="10" FontWeight="Bold" Margin="22,22,0,6" />
                        <Button Style="{StaticResource NavButton}" Content="⚙  Paramètres et comptes" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#0F1D31" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.DisplayName}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Session sécurisée" Foreground="#8297B5" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E4EDFB" CornerRadius="15" Padding="11,5"><TextBlock Text="{Binding EnvironmentLabel}" Foreground="{StaticResource BlueDarkBrush}" FontWeight="SemiBold" FontSize="11" /></Border>
                        <TextBlock Text="{Binding LastModification}" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding UpdateLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdateCommand}" Margin="0,0,10,0" />
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,24">
                <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}" />
                <views:ComponentsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Components}" />
                <views:FurnitureView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Furniture}" />
                <views:CatalogView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Catalog}" />
                <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}" />
                <views:FutureView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Future}" />
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid><TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBlock Text="{Binding Version, StringFormat='Atlas v{0}'}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
