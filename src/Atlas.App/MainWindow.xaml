<Window x:Class="Atlas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Atlas.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Biblidéo Atlas" MinWidth="1180" MinHeight="720" Width="1500" Height="920"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" StateChanged="Window_StateChanged">
    <Window.Resources>
        <Geometry x:Key="HomeIcon">M3,10 L12,3 L21,10 M5,9 L5,21 L19,21 L19,9 M9,21 L9,14 L15,14 L15,21</Geometry>
        <Geometry x:Key="ComponentsIcon">M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z</Geometry>
        <Geometry x:Key="FurnitureIcon">M4,5 L20,5 M4,12 L20,12 M4,19 L20,19 M4,5 L4,19 M20,5 L20,19 M8,8 L16,8 M8,15 L16,15</Geometry>
        <Geometry x:Key="LinksIcon">M9,15 L7,17 A4,4 0 0 1 1,11 L5,7 A4,4 0 0 1 11,7 M15,9 L17,7 A4,4 0 0 1 23,13 L19,17 A4,4 0 0 1 13,17 M8,12 L16,12</Geometry>
        <Geometry x:Key="HorizonIcon">M12,2 L22,12 L12,22 L2,12 Z M7,12 L17,12 M12,7 L12,17</Geometry>
        <Geometry x:Key="SettingsIcon">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13.5,5.2 L17,4 L18.3,7.3 L22,8.5 L21,12 L22,15.5 L18.3,16.7 L17,20 L13.5,18.8 L12,22 L10.5,18.8 L7,20 L5.7,16.7 L2,15.5 L3,12 L2,8.5 L5.7,7.3 L7,4 L10.5,5.2 Z</Geometry>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
      <Grid ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NavigationWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Background="{StaticResource NavGradient}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,1,0" CornerRadius="11,0,0,11">
                <Grid>
                    <Rectangle Fill="{StaticResource AtlasGridBrush}" IsHitTestVisible="False"/>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="16,14,12,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="13" Background="#122C41" BorderBrush="#345875" BorderThickness="1">
                                <Image Source="pack://application:,,,/Assets/IdeoMark.png" Margin="7"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="ATLAS" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="BIBLIDÉO" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="9"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="‹" FontSize="23" Style="{StaticResource IconButton}" Command="{Binding ToggleNavigationCommand}" ToolTip="Réduire ou développer le menu" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="PILOTAGE" Style="{StaticResource NavSection}" Visibility="{Binding ShowAdministrativeNavigationLabels, Converter={StaticResource BoolVisibility}}"/>
                                <Button Style="{StaticResource NavButton}" Background="{Binding DashboardNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" ToolTip="Vue d’ensemble" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource HomeIcon}" Style="{StaticResource NavPathIcon}"/><TextBlock Grid.Column="1" Text="Vue d’ensemble" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                                </Button>

                                <TextBlock Text="FORGE" Style="{StaticResource NavSection}" Margin="24,25,0,8" Visibility="{Binding ShowAdministrativeNavigationLabels, Converter={StaticResource BoolVisibility}}"/>
                                <Button Style="{StaticResource NavButton}" Background="{Binding ComponentsNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Components" ToolTip="Bibliothèque de composants" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource ComponentsIcon}" Style="{StaticResource NavPathIcon}" Stroke="{StaticResource CyanBrush}"/><TextBlock Grid.Column="1" Text="Composants" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Background="{Binding FurnitureNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Furniture" ToolTip="Meubles et compositions" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource FurnitureIcon}" Style="{StaticResource NavPathIcon}" Stroke="{StaticResource AmberBrush}"/><TextBlock Grid.Column="1" Text="Meubles &amp; variantes" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Background="{Binding FutureNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Future" ToolTip="Compatibilités" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource LinksIcon}" Style="{StaticResource NavPathIcon}" Stroke="{StaticResource RoseBrush}"/><TextBlock Grid.Column="1" Text="Compatibilités" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                                </Button>

                                <TextBlock Text="EXPÉRIENCE" Style="{StaticResource NavSection}" Margin="24,25,0,8" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/>
                                <Button Style="{StaticResource NavButton}" Background="{Binding CatalogNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Catalog" ToolTip="Horizon — expérience client Atlas">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource HorizonIcon}" Style="{StaticResource NavPathIcon}" Stroke="{StaticResource CyanBrush}"/><TextBlock Grid.Column="1" Text="Horizon" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                                </Button>

                            </StackPanel>
                            <Border Grid.Row="1" Margin="14,5,12,5" Padding="7" CornerRadius="12" Background="#95121C25" BorderBrush="#445764" BorderThickness="1"
                                    Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Margin="5,3,5,9" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="UNIVERS" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="Choisir un espace" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                        <ItemsControl ItemsSource="{Binding ClientUniverseFacets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,3,9" Height="108">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Foreground="White">
                                                            <CheckBox.Template>
                                                                <ControlTemplate TargetType="CheckBox">
                                                                    <Border x:Name="UniverseCard" Background="#202A33" BorderBrush="#52636F" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                                                            <Rectangle>
                                                                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#08040A0E" Offset="0"/><GradientStop Color="#38040A0E" Offset="0.48"/><GradientStop Color="#E00A1117" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                                                            </Rectangle>
                                                                            <StackPanel VerticalAlignment="Bottom" Margin="11,0,38,10">
                                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Count, StringFormat='{}{0} modèle(s)'}" FontSize="10" Foreground="#D3DCE2" Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                            <Border x:Name="SelectedMark" Width="5" Background="{StaticResource CyanBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UniverseCard" Property="BorderBrush" Value="#9BAAB3"/></Trigger>
                                                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="UniverseCard" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="UniverseCard" Property="BorderThickness" Value="2"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </CheckBox.Template>
                                                        </CheckBox>
                                                        <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="0" Padding="0" FontSize="14" Background="#D20E171E" BorderBrush="#78909E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Click="ClientFacetFavorite_OnClick" ToolTip="Épingler cet univers"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,4,0,0" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="SYSTÈME" Style="{StaticResource NavSection}" Margin="24,5,0,5" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SettingsNavBackground}" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Paramètres et comptes">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource NavPathIcon}"/><TextBlock Grid.Column="1" Text="Paramètres" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"/></Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="3" Background="#9A102536" BorderBrush="#294B63" BorderThickness="1" CornerRadius="12" Margin="12" Padding="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimaryGradient}"><TextBlock Text="ID" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SessionLabel}" Style="{StaticResource Caption}"/></StackPanel>
                                <Button Grid.Column="2" Content="↪" Style="{StaticResource IconButton}" ToolTip="Accès administrateur" Click="AccessAdministrator_Click" Visibility="{Binding ShowUserSessionActions, Converter={StaticResource BoolVisibility}}"/>
                                <Button Grid.Column="2" Content="↩" Style="{StaticResource IconButton}" ToolTip="Se déconnecter du mode administrateur" Click="Logout_Click" Visibility="{Binding ShowAdministrativeSessionActions, Converter={StaticResource BoolVisibility}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Espace de travail -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                <Border Background="#F2091927" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#152F43" BorderBrush="#345875" BorderThickness="1" CornerRadius="14" Padding="11,6"><TextBlock Text="{Binding EnvironmentLabel}" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold"/></Border>
                            <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="14,0"/>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Espace Atlas" FontWeight="SemiBold"/><TextBlock Text="{Binding LastModification}" Style="{StaticResource Caption}"/></StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="{Binding UpdateLabel}" Style="{StaticResource GhostButton}" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,0" Padding="12,7"/>
                            <Button Content="Enregistrer" Command="{Binding SaveCommand}" Margin="0,0,12,0" Padding="15,7" Visibility="{Binding IsAdministrativeMode, Converter={StaticResource BoolVisibility}}"/>
                            <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                            <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click"/>
                            <Button Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
                    <Rectangle Fill="{StaticResource AmbientGlow}" IsHitTestVisible="False"/>
                    <Grid Margin="18,16,18,14" HorizontalAlignment="Stretch">
                        <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}"/>
                        <views:ComponentsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Components}"/>
                        <views:FurnitureView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Furniture}"/>
                        <views:CatalogView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Catalog}"/>
                        <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}"/>
                        <views:FutureView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Future}"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#F2091927" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="24,0,16,0">
                    <Grid><TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="{Binding Version, StringFormat='Atlas v{0}'}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </Border>
            </Grid>
        </Grid>
      </Grid>
    </Border>
</Window>
