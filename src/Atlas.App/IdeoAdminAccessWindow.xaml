<Window x:Class="Atlas.App.IdeoAdminAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accès Administrateur Idéo" Width="780" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Effect="{StaticResource PanelShadow}">
        <Grid Margin="34,26,34,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel><TextBlock Text="ACCÈS INTERNE IDÉO" Style="{StaticResource Eyebrow}"/><TextBlock Text="Ouvrir une session Administrateur Idéo" Style="{StaticResource PageTitle}" Margin="0,5,0,0"/></StackPanel>
                <Button Content="×" Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_OnClick"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0"><StackPanel>
                <TextBlock Text="Cette demande est liée à ce poste et à cette fenêtre. La réponse Idéo est valable quelques minutes et ne peut être utilisée qu’une seule fois." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="Identifiant du poste" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                <TextBox x:Name="DeviceIdBox" IsReadOnly="True"/>
                <TextBlock Text="Demande d’accès à transmettre à Stéphane ou Thomas" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                <TextBox x:Name="RequestCodeBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="94" VerticalContentAlignment="Top"/>
                <Button Content="Copier la demande" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="CopyRequest_OnClick"/>
                <TextBlock Text="Réponse signée Idéo" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                <TextBox x:Name="ResponseCodeBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="105" VerticalContentAlignment="Top"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <Button Content="Ouvrir la session Administrateur Idéo" Height="46" Margin="0,14,0,0" Click="Unlock_OnClick"/>
            </StackPanel></ScrollViewer>
        </Grid>
    </Border>
</Window>
